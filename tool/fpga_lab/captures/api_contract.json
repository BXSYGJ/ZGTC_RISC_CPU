# fpga_lab bridge server — Platform API contract (captured live 2026-09-07)
# Base: http://www.logicmatrixsemi.com:5174
# Auth:  Bearer <token> from POST /api/auth/login data.token
# All responses: {success: bool, data?, message?, requestId?}

endpoints:
  login:
    method: POST
    path: /api/auth/login
    body: {"identifier": "<email>", "password": "<pw>", "role": "developer", "loginType": "local"}
    response_data: {user: {...}, token: "<JWT>", refreshToken: "<JWT>"}
  heartbeat:
    method: POST
    path: /api/auth/heartbeat
  profile:
    method: GET
    path: /api/auth/profile
  current_device:
    method: POST
    path: /api/developer/devices/current
    note: data = null or {device_id, session_id, device_number, device_name, board_model,
                          status, duration_minutes, planned_end_time, ...}
  device_catalog:
    method: POST
    path: /api/developer/devices
    note: data = [{id, name, device_number, status, board_model, hardware_profile,
                   device_capabilities:{camera,oscilloscope,...}}]
  reserve_by_type:
    method: POST
    path: /api/developer/devices/request-by-type
    body: {"cardType": "with_camera", "durationMinutes": 10}
    response_data: {sessionId, deviceId, deviceName, deviceNumber, plannedEndTime,
                    duration, isReservation, status}
  release:
    method: POST
    path: /api/developer/devices/release
    body: {"deviceId": <n>}
  reservations_my:
    method: GET
    path: /api/developer/reservations/my
  stats:
    method: POST
    path: /api/developer/devices/stats
  firmware_info:
    method: GET
    path: /api/modules/firmware/info/{deviceId}
  firmware_check_jtag:
    method: POST
    path: /api/modules/firmware/check-jtag
    body: {"deviceId": <n>}
  firmware_download:
    method: POST
    path: /api/modules/firmware/download
    multipart: {"firmware": "<file .sbit>", "deviceId": "<n>"}
    note: response data {deviceId,userId,...}; then poll progress; board wakes -> message
  firmware_progress:
    method: POST
    path: /api/modules/firmware/progress
    body: {"deviceId": <n>}
  serial_status:
    method: POST
    path: /api/modules/serial-port/status
    body: {"deviceId": <n>}
  serial_open:
    method: POST
    path: /api/modules/serial-port/open
    body: {"deviceId": <n>, "baudRate":115200,"dataBits":8,"stopBits":1,"parity":"none","flowControl":0}
    note: 409 if board has no firmware yet
  serial_send:
    method: POST
    path: /api/modules/serial-port/send
    body: {"deviceId": <n>, "data": "<string>", "mode": "text"|"hex"}
    response_data: {bytesSent}
  serial_read:
    method: POST
    path: /api/modules/serial-port/read
    body: {"deviceId": <n>, "length": 64}
    response_data: {requestedBytes, bytesRead, hasData, data, hex, timestamp}
  serial_close:
    method: POST
    path: /api/modules/serial-port/close
    body: {"deviceId": <n>}

# WebSocket (optional telemetry; serial RX also arrives here):
#   ws://www.logicmatrixsemi.com:5174/ws?token=<JWT>
#   frames: {"type":"ping"/"pong"/"serial_rx"(deviceId,data,hex,bytesRead)/"firmware_progress"/...}

# Device box types (request-by-type cardType): with_camera | without_camera
# Reservation durations (UI): 10 / 20 / 30 minutes
# RemoteLab UART pins: RX AC26, TX AB26, default 115200 8N1
