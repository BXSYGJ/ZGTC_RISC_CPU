# PDS project databases and generated implementation directories
*.pds
compile/
synthesize/
device_map/
place_route/
report_timing/
generate_bitstream/
constraint_check/
log/
logbackup/
ipcore/
# 100H CPU 工程的 DDR3 IP 源码需要入库（其余 ipcore/ 是 PDS 生成物）
!pds_cpu_100h/ipcore/
# InstRec-FPGA 的 DDR3/GPLL IP 源文件是重建必需资产，必须入库
!instrec_fpga/ipcore/
impl.tcl
multiseed_summary.csv

# FPGA programming and implementation artifacts
*.sbit
# 里程碑位流按 releases 目录归档入库（其余 *.sbit 仍是构建产物）
!instrec_fpga/releases/**/*.sbit
!pds_cpu_100h/releases/**/*.sbit
*.smsk
*.bgr
*.adf
*.db
*.cmr
*.snr
*.dmr
*.prr
*.rtr
*.prt
*.netlist
*.vm
*.pcf

