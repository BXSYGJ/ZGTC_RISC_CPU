module pds_soc_top (
    input wire clk,
    input wire rst_n,
    input wire key,
    input wire uart_rx,
    output wire uart_tx,
    input wire spi_miso,
    output wire spi_cs,
    output wire spi_sck,
    output wire spi_mosi,
    output wire [7:0] led,
    input wire ref_clk_p,
    input wire ref_clk_n,
    output wire [14:0] mem_a,
    output wire [2:0]  mem_ba,
    output wire        mem_ck,
    output wire        mem_ck_n,
    output wire        mem_cke,
    output wire        mem_cs_n,
    output wire        mem_ras_n,
    output wire        mem_cas_n,
    output wire        mem_we_n,
    output wire        mem_odt,
    output wire        mem_rst_n,
    inout  wire [31:0] mem_dq,
    inout  wire [3:0]  mem_dqs,
    inout  wire [3:0]  mem_dqs_n,
    output wire [3:0]  mem_dm
);
    wire cpu_clk,clock_locked;
    generate
        if(__CLOCK_HZ__==27000000) begin : direct_clock
            assign cpu_clk=clk;
            assign clock_locked=1'b1;
        end else begin : multiplied_clock
            rv32_pll #(.CLOCK_HZ(__CLOCK_HZ__)) clock_source(
                .reference_clk(clk),.reset(~rst_n),.cpu_clk(cpu_clk),.locked(clock_locked)
            );
        end
    endgenerate
    rv32_board_top #(.DATA_OVERLAP(__DATA_OVERLAP__),.BTB_INDEX_BITS(__BTB_INDEX_BITS__),.EARLY_D_REQUEST(__EARLY_D_REQUEST__),.FAST_DCACHE_WRITE(__FAST_DCACHE_WRITE__),.FAST_DCACHE_READ(__FAST_DCACHE_READ__),.FETCH_OVERLAP(__FETCH_OVERLAP__),.ENABLE_M(__ENABLE_M__),.CLOCK_HZ(__CLOCK_HZ__),.INIT_FILE("__FIRMWARE_HEX__"),.ENABLE_PREDICTOR(__PREDICTOR__),.LOAD_USE_BUBBLE(__LOAD_USE_BUBBLE__),.FAST_ICACHE_HIT(__FAST_ICACHE_HIT__),.ICACHE_SET_BITS(__ICACHE_SET_BITS__),.CACHE_SET_BITS(__CACHE_SET_BITS__),.CACHE_ADDRESS_BITS(__CACHE_ADDRESS_BITS__),.ENABLE_CACHE(__ENABLE_CACHE__),.UART_BAUD(__UART_BAUD__)) board(
        .clk(cpu_clk),.rst_n(rst_n & clock_locked),.key(key),.uart_rx(uart_rx),.uart_tx(uart_tx),.spi_miso(spi_miso),.spi_cs(spi_cs),.spi_sck(spi_sck),.spi_mosi(spi_mosi),.led(led),
        .ref_clk_p(ref_clk_p),.ref_clk_n(ref_clk_n),
        .mem_a(mem_a),.mem_ba(mem_ba),.mem_ck(mem_ck),.mem_ck_n(mem_ck_n),.mem_cke(mem_cke),
        .mem_cs_n(mem_cs_n),.mem_ras_n(mem_ras_n),.mem_cas_n(mem_cas_n),.mem_we_n(mem_we_n),.mem_odt(mem_odt),.mem_rst_n(mem_rst_n),
        .mem_dq(mem_dq),.mem_dqs(mem_dqs),.mem_dqs_n(mem_dqs_n),.mem_dm(mem_dm)
    );
endmodule