create_clock -name {core_clk} [get_ports {clk}] -period {6.890612} -waveform {0.000000 3.445306}
set_clock_uncertainty 0.150 [get_clocks {core_clk}]
set_input_delay -clock {core_clk} -clock_fall -max 0.500 [get_ports {fixture_reset_n scan_in scan_shift scan_update scan_capture}]
set_input_delay -clock {core_clk} -clock_fall -min 0.000 [get_ports {fixture_reset_n scan_in scan_shift scan_update scan_capture}]
set_output_delay -clock {core_clk} -max 0.500 [get_ports {scan_out}]
set_output_delay -clock {core_clk} -min 0.000 [get_ports {scan_out}]
set_multicycle_path 2 -setup -to [get_ports {scan_out}]
set_multicycle_path 1 -hold -to [get_ports {scan_out}]
define_attribute {v:rv32_bare_core} {syn_hier} {fixed}
define_attribute {v:rv32_core} {syn_hier} {fixed}
define_attribute {p:clk} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clk} {PAP_IO_LOC} {D18}
define_attribute {p:clk} {PAP_IO_VCCIO} {3.3}
define_attribute {p:clk} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:clk} {PAP_IO_NONE} {TRUE}
define_attribute {p:fixture_reset_n} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:fixture_reset_n} {PAP_IO_LOC} {C22}
define_attribute {p:fixture_reset_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:fixture_reset_n} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:fixture_reset_n} {PAP_IO_NONE} {TRUE}
define_attribute {p:scan_in} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:scan_in} {PAP_IO_LOC} {C23}
define_attribute {p:scan_in} {PAP_IO_VCCIO} {3.3}
define_attribute {p:scan_in} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:scan_in} {PAP_IO_NONE} {TRUE}
define_attribute {p:scan_shift} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:scan_shift} {PAP_IO_LOC} {A20}
define_attribute {p:scan_shift} {PAP_IO_VCCIO} {3.3}
define_attribute {p:scan_shift} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:scan_shift} {PAP_IO_NONE} {TRUE}
define_attribute {p:scan_update} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:scan_update} {PAP_IO_LOC} {C18}
define_attribute {p:scan_update} {PAP_IO_VCCIO} {3.3}
define_attribute {p:scan_update} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:scan_update} {PAP_IO_NONE} {TRUE}
define_attribute {p:scan_capture} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:scan_capture} {PAP_IO_LOC} {C19}
define_attribute {p:scan_capture} {PAP_IO_VCCIO} {3.3}
define_attribute {p:scan_capture} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:scan_capture} {PAP_IO_NONE} {TRUE}
define_attribute {p:scan_out} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:scan_out} {PAP_IO_LOC} {E18}
define_attribute {p:scan_out} {PAP_IO_VCCIO} {3.3}
define_attribute {p:scan_out} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:scan_out} {PAP_IO_NONE} {TRUE}
define_attribute {p:scan_out} {PAP_IO_DRIVE} {8}
define_attribute {p:scan_out} {PAP_IO_SLEW} {SLOW}
