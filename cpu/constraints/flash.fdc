# Buildable pin set used for the UART-load diagnostic bitstream.
# U9's real clock (H13) is a dedicated config pin that PDS cannot place as a
# user IO, so the soft-SPI path cannot reach U9 on this board. These pins keep
# the design synthesizable for the verified UART 'R' load-and-run workflow;
# the authoritative U9 mapping (CS=F25 CLK=H13 DI=R14 DO=R15 WP=P14 HOLD=N14)
# is documented in cpu/docs/FLASH_BOOT.md.

define_attribute {p:spi_cs}    {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:spi_cs}    {PAP_IO_LOC}        {R15}
define_attribute {p:spi_cs}    {PAP_IO_VCCIO}      {3.3}
define_attribute {p:spi_cs}    {PAP_IO_STANDARD}   {LVCMOS33}
define_attribute {p:spi_cs}    {PAP_IO_DRIVE}      {8}
define_attribute {p:spi_cs}    {PAP_IO_SLEW}       {SLOW}
define_attribute {p:spi_cs}    {PAP_IO_NONE}       {TRUE}

define_attribute {p:spi_sck}   {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:spi_sck}   {PAP_IO_LOC}        {P18}
define_attribute {p:spi_sck}   {PAP_IO_VCCIO}      {3.3}
define_attribute {p:spi_sck}   {PAP_IO_STANDARD}   {LVCMOS33}
define_attribute {p:spi_sck}   {PAP_IO_DRIVE}      {8}
define_attribute {p:spi_sck}   {PAP_IO_SLEW}       {SLOW}
define_attribute {p:spi_sck}   {PAP_IO_NONE}       {TRUE}

define_attribute {p:spi_mosi}  {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:spi_mosi}  {PAP_IO_LOC}        {P14}
define_attribute {p:spi_mosi}  {PAP_IO_VCCIO}      {3.3}
define_attribute {p:spi_mosi}  {PAP_IO_STANDARD}   {LVCMOS33}
define_attribute {p:spi_mosi}  {PAP_IO_DRIVE}      {8}
define_attribute {p:spi_mosi}  {PAP_IO_SLEW}       {SLOW}
define_attribute {p:spi_mosi}  {PAP_IO_NONE}       {TRUE}

define_attribute {p:spi_miso}  {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:spi_miso}  {PAP_IO_LOC}        {N14}
define_attribute {p:spi_miso}  {PAP_IO_VCCIO}      {3.3}
define_attribute {p:spi_miso}  {PAP_IO_STANDARD}   {LVCMOS33}

set_false_path -from [get_ports {spi_miso}]