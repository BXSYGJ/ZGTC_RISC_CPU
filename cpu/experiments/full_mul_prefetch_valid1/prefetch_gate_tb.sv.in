module prefetch_gate_tb;
    reg [31:0] registers[0:31];
    reg [31:0] register_valid,wb_data;
    reg [4:0] id_rs1,id_rs2,wb_rd;
    reg trace_write;
    reg expected_a,expected_b;
    reg [31:0] expected_operand_a,expected_operand_b;
    integer source_index,write_index,flags,same_source,register_index,checks=0;
    __DECLARATIONS__
    initial begin
        for(register_index=0;register_index<32;register_index=register_index+1)
            registers[register_index]=32'hdead0000+register_index;
        for(source_index=0;source_index<32;source_index=source_index+1)
        for(write_index=0;write_index<32;write_index=write_index+1)
        for(flags=0;flags<8;flags=flags+1)
        for(same_source=0;same_source<2;same_source=same_source+1) begin
            id_rs1=source_index; id_rs2=same_source ? source_index : ((source_index+11)%32);
            wb_rd=write_index; trace_write=flags[2]; register_valid=0;
            register_valid[id_rs1]=flags[0]; register_valid[id_rs2]=flags[1];
            wb_data=32'hcafebabe^(write_index<<8);
            expected_a=(id_rs1!=0) && (register_valid[id_rs1] || (trace_write && wb_rd==id_rs1));
            expected_b=(id_rs2!=0) && (register_valid[id_rs2] || (trace_write && wb_rd==id_rs2));
            expected_operand_a=(trace_write && wb_rd==id_rs1) ? wb_data : registers[id_rs1];
            expected_operand_b=(trace_write && wb_rd==id_rs2) ? wb_data : registers[id_rs2];
            #1; checks=checks+1;
            if(mul_id_a_available!==expected_a || mul_id_b_available!==expected_b ||
               mul_id_operand_a!==expected_operand_a || mul_id_operand_b!==expected_operand_b)
                $fatal(1,"FAIL prefetch_gate checks=%0d",checks);
        end
        register_valid=0; trace_write=0; id_rs1=6; id_rs2=8;
        registers[6]=32'hxxxxxxxx; registers[8]=32'hxxxxxxxx;
        #1;
        if(mul_id_a_available!==0 || mul_id_b_available!==0)
            $fatal(1,"FAIL prefetch_gate unknown payload became available");
        $display("PASS prefetch_gate checks=%0d unknown_rejected=1",checks);
        $finish;
    end
endmodule
