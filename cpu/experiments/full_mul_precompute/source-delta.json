  "parent": "build/regfile-valid-fanout-stage",
  "scope": "Independent low multiply precompute, not qualified for hardware",
  "edits": {
    "rtl/rv32_core.sv": [
      [
        "    reg muldiv_started;",
        "    reg muldiv_started;\n    reg mul_precomputed;\n    wire mul_prefetch_operands=!(ex_valid && ex_muldiv);\n    wire mul_precompute=id_fire && id_instruction[6:0]==7'h33 &&\n        id_instruction[31:25]==1 && id_instruction[14:12]==0 &&\n        mul_prefetch_operands && muldiv_ready &&\n        !(ex_valid && ex_decode.writes_rd && ex_rd!=0 && (ex_rd==id_rs1 || ex_rd==id_rs2)) &&\n        !(mem_valid && mem_writes && mem_rd!=0 && (mem_rd==id_rs1 || mem_rd==id_rs2));\n    always @(posedge clk or negedge rst_n) begin\n        if(!rst_n) mul_precomputed<=0;\n        else mul_precomputed<=mul_precompute;\n    end"
      ],
      [
        "        rv32_muldiv unit(",
        "        rv32_muldiv #(.PRECOMPUTE(1)) unit("
      ],
      [
        "            .req_operation(ex_instruction[14:12]),.req_operand_a(forwarded_a),.req_operand_b(forwarded_b),",
        "            .req_precomputed(mul_precomputed),.req_operation(ex_instruction[14:12]),\n            .req_operand_a(mul_prefetch_operands ? id_operand_a : forwarded_a),\n            .req_operand_b(mul_prefetch_operands ? id_operand_b : forwarded_b),"
      ]
    ],
    "rtl/rv32_muldiv.sv": [
      [
        "module rv32_muldiv (",
        "module rv32_muldiv #(parameter integer PRECOMPUTE=0) ("
      ],
      [
        "    input wire req_valid,",
        "    input wire req_valid,\n    input wire req_precomputed,"
      ],
      [
        "    assign rsp_valid=(state==RESPONSE || early_product) && !cancel;\n    assign rsp_data=early_product ? (operation==0 ? product[31:0] : product[63:32]) : response_data;",
        "    wire immediate_product=PRECOMPUTE!=0 && state==IDLE && req_valid && req_precomputed && req_operation==0;\n    assign rsp_valid=(state==RESPONSE || early_product || immediate_product) && !cancel;\n    assign rsp_data=immediate_product ? product[31:0] :\n        (early_product ? (operation==0 ? product[31:0] : product[63:32]) : response_data);"
      ],
      [
        "                    if(!req_operation[2]) begin",
        "                    if(immediate_product) begin\n                        if(!rsp_ready) begin\n                            response_data<=product[31:0];\n                            state<=RESPONSE;\n                        end\n                    end else if(!req_operation[2]) begin"
      ],
      [
        "endmodule\n\n",
        "endmodule\n"
      ]
    ]
  },
