module pds_soc_top (
    input wire clk,
    input wire rst_n,
    input wire key,
    input wire uart_rx,
    output wire uart_tx,
    output wire [7:0] led
);
    wire cpu_clk, clock_locked;
    generate
        if (__CLOCK_HZ__ == 27000000) begin : direct_clock
            assign cpu_clk = clk;
            assign clock_locked = 1'b1;
        end else begin : multiplied_clock
            rv32_pll #(.CLOCK_HZ(__CLOCK_HZ__)) clock_source(
                .reference_clk(clk), .reset(~rst_n), .cpu_clk(cpu_clk), .locked(clock_locked)
            );
        end
    endgenerate
    wire [31:0] status_code, trap_cause;
    wire [63:0] cycle_count, retired_count;
    wire maintenance_fault, trace_valid, trap_valid;
    wire soc_serial_tx;
    reg [7:0] led_register;
    assign uart_tx = soc_serial_tx;
    assign led = led_register;
    always @(posedge cpu_clk or negedge rst_n) begin
        if (!rst_n) led_register <= 8'b0;
        else led_register <= retired_count[7:0];
    end
    rv32_soc #(.DATA_OVERLAP(__DATA_OVERLAP__), .BTB_INDEX_BITS(__BTB_INDEX_BITS__), .EARLY_D_REQUEST(__EARLY_D_REQUEST__),
        .ENABLE_M(__ENABLE_M__), .CLOCK_HZ(__CLOCK_HZ__), .ENABLE_PREDICTOR(__PREDICTOR__), .LOAD_USE_BUBBLE(__LOAD_USE_BUBBLE__),
        .FETCH_OVERLAP(__FETCH_OVERLAP__), .FAST_DCACHE_WRITE(__FAST_DCACHE_WRITE__), .FAST_DCACHE_READ(__FAST_DCACHE_READ__),
        .FAST_ICACHE_HIT(__FAST_ICACHE_HIT__), .ICACHE_SET_BITS(__ICACHE_SET_BITS__), .CACHE_SET_BITS(__CACHE_SET_BITS__),
        .ENABLE_CACHE(__ENABLE_CACHE__), .BAUD(__UART_BAUD__), .INIT_FILE("__FIRMWARE_HEX__")) soc(
        .clk(cpu_clk), .rst_n(rst_n & clock_locked), .serial_rx(uart_rx), .serial_tx(soc_serial_tx),
        .gpio_input(8'b0), .gpio_output(), .status_code(status_code), .maintenance_fault(maintenance_fault), .trace_valid(trace_valid),
        .trace_pc(), .trace_instruction(), .trap_valid(trap_valid), .trap_cause(trap_cause),
        .cycle_count(cycle_count), .retired_count(retired_count)
    );
endmodule
