`timescale 1ns/1ps
module id_relation_mask_tb;
    reg [31:0] registers[0:31];
    reg [31:0] register_valid;
    reg [4:0] id_rs1,id_rs2,wb_rd;
    reg trace_write;
    reg [31:0] wb_data;
    reg [31:0] random_state=32'h91a7034d;
    reg [2:0] actual,expected,independent;
    integer source_pair,control_bits,wb_route,register_index,checks=0;
    integer invalid_a=0,invalid_b=0,wb_a=0,wb_b=0;
    __FUNCTIONS__
    __DECLARATIONS__
    task advance_random;
        begin
            random_state=random_state^(random_state<<13);
            random_state=random_state^(random_state>>17);
            random_state=random_state^(random_state<<5);
        end
    endtask
    initial begin
        for(source_pair=0;source_pair<1024;source_pair=source_pair+1) begin
            for(control_bits=0;control_bits<8;control_bits=control_bits+1) begin
                for(wb_route=0;wb_route<4;wb_route=wb_route+1) begin
                    id_rs1=source_pair[4:0];
                    id_rs2=source_pair[9:5];
                    case(wb_route)
                        0: wb_rd=id_rs1;
                        1: wb_rd=id_rs2;
                        2: wb_rd=id_rs1+5'd7;
                        3: wb_rd=0;
                    endcase
                    trace_write=control_bits[2];
                    register_valid=0;
                    register_valid[id_rs1]=control_bits[0];
                    register_valid[id_rs2]=control_bits[1];
                    for(register_index=0;register_index<32;register_index=register_index+1) begin
                        advance_random();
                        registers[register_index]=random_state;
                    end
                    advance_random();
                    wb_data=random_state;
                    case(source_pair[2:0])
                        0: begin registers[id_rs1]=0; registers[id_rs2]=0; wb_data=0; end
                        1: begin registers[id_rs1]=32'h80000000; registers[id_rs2]=32'h7fffffff; end
                        2: begin registers[id_rs1]=32'hffffffff; registers[id_rs2]=1; end
                        3: begin registers[id_rs1]=registers[id_rs2]; wb_data=registers[id_rs2]; end
                        4: begin registers[id_rs1]=1; registers[id_rs2]=32'hffffffff; end
                        5: begin registers[id_rs1]=32'h00010000; registers[id_rs2]=32'h0000ffff; end
                    endcase
                    if(!register_valid[id_rs1]) registers[id_rs1]=32'bx;
                    if(!register_valid[id_rs2]) registers[id_rs2]=32'bz;
                    #1;
                    actual=masked_operand_relation(mul_id_operand_a,mul_id_operand_b,id_relation_a_valid,id_relation_b_valid);
                    expected=operand_relation(id_operand_a,id_operand_b);
                    independent={id_operand_a==id_operand_b,id_operand_a<id_operand_b,$signed(id_operand_a)<$signed(id_operand_b)};
                    if((^id_operand_a===1'bx) || (^id_operand_b===1'bx)) $fatal(1,"FAIL mask: reference unexpectedly unknown");
                    if(actual!==expected || actual!==independent) $fatal(1,"FAIL mask pair=%0d control=%0d route=%0d actual=%b expected=%b independent=%b",source_pair,control_bits,wb_route,actual,expected,independent);
                    invalid_a=invalid_a+!id_relation_a_valid;
                    invalid_b=invalid_b+!id_relation_b_valid;
                    wb_a=wb_a+(trace_write && wb_rd==id_rs1);
                    wb_b=wb_b+(trace_write && wb_rd==id_rs2);
                    checks=checks+1;
                end
            end
        end
        if(checks!=32768 || invalid_a==0 || invalid_b==0 || wb_a==0 || wb_b==0) $fatal(1,"FAIL mask: insufficient coverage");
        $display("PASS mask checks=%0d invalid_a=%0d invalid_b=%0d wb_a=%0d wb_b=%0d",checks,invalid_a,invalid_b,wb_a,wb_b);
        $finish;
    end
endmodule
