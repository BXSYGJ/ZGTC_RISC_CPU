    wire reference_req_ready;
    wire reference_rsp_valid;
    wire reference_rsp_error;
    wire reference_serial_tx;
    wire reference_irq_external;
    wire reference_irq_software;
    wire reference_irq_timer;
    wire [31:0] reference_rsp_data;
    wire [31:0] reference_status_code;
    wire [63:0] reference_timer_value;
    wire [7:0] reference_gpio_output;
    integer differential_cycles=0;
    rv32_peripherals_reference #(.CLOCK_HZ(3200),.BAUD(100)) reference_peripherals(
        .clk(clk),
        .rst_n(rst_n),
        .performance_values(performance_values),
        .performance_config(performance_config),
        .req_valid(req_valid),
        .req_address(req_address),
        .req_write(req_write),
        .req_data(req_data),
        .req_strobe(req_strobe),
        .rsp_ready(rsp_ready),
        .serial_rx(serial_rx),
        .gpio_input(gpio_input),
        .req_ready(reference_req_ready),
        .rsp_valid(reference_rsp_valid),
        .rsp_error(reference_rsp_error),
        .serial_tx(reference_serial_tx),
        .irq_external(reference_irq_external),
        .irq_software(reference_irq_software),
        .irq_timer(reference_irq_timer),
        .rsp_data(reference_rsp_data),
        .status_code(reference_status_code),
        .timer_value(reference_timer_value),
        .gpio_output(reference_gpio_output));
    always @(negedge clk) begin
        #1;
        if(rst_n) begin
            differential_cycles=differential_cycles+1;
            if({req_ready,rsp_valid,rsp_error,serial_tx,irq_external,irq_software,irq_timer,rsp_data,status_code,timer_value,gpio_output} !==
               {reference_req_ready,reference_rsp_valid,reference_rsp_error,reference_serial_tx,reference_irq_external,reference_irq_software,reference_irq_timer,reference_rsp_data,reference_status_code,reference_timer_value,reference_gpio_output})
                $fatal(1,"FAIL banked differential cycle=%0d address=%08x",differential_cycles,req_address);
        end
    end

    function automatic known_read_address(input [31:0] address);
        begin
            case(address)
                32'h10000000: known_read_address=1;
                32'h10000004: known_read_address=1;
                32'h10000100: known_read_address=1;
                32'h10000104: known_read_address=1;
                32'h10000108: known_read_address=1;
                32'h1000010c: known_read_address=1;
                32'h10000200: known_read_address=1;
                32'h10000204: known_read_address=1;
                32'h10000208: known_read_address=1;
                32'h1000020c: known_read_address=1;
                32'h10000300: known_read_address=1;
                32'h10000304: known_read_address=1;
                32'h10000308: known_read_address=1;
                32'h1000030c: known_read_address=1;
                32'h10000310: known_read_address=1;
                32'h10000400: known_read_address=1;
                32'h10000404: known_read_address=1;
                32'h10000410: known_read_address=1;
                32'h10000414: known_read_address=1;
                32'h10000418: known_read_address=1;
                32'h1000041c: known_read_address=1;
                32'h10000420: known_read_address=1;
                32'h10000424: known_read_address=1;
                32'h10000428: known_read_address=1;
                32'h1000042c: known_read_address=1;
                32'h10000430: known_read_address=1;
                default: known_read_address=0;
            endcase
        end
    endfunction
    task exercise_banked_addresses;
        reg [31:0] address;
        begin
            for(integer offset=0;offset<2048;offset=offset+1) begin
                address=32'h10000000+offset;
                access(0,address,0,0,!known_read_address(address),read_value);
            end
            for(integer upper_bit=11;upper_bit<32;upper_bit=upper_bit+1) begin
                for(integer offset=0;offset<2048;offset=offset+4) begin
                    address=(32'h10000000+offset) ^ (32'd1 << upper_bit);
                    access(0,address,0,0,1,read_value);
                end
            end
            access(0,32'hx0000000,0,0,1,read_value);
            access(0,32'hz0000004,0,0,1,read_value);
            for(integer snapshot=0;snapshot<16;snapshot=snapshot+1) begin
                for(integer word_index=0;word_index<9;word_index=word_index+1)
                    performance_values[word_index*32+:32]=32'h80204081 ^ (32'h1020304 * word_index) ^ snapshot;
                write_reg(32'h10000400,1,1);
                for(integer word_index=0;word_index<9;word_index=word_index+1)
                    read_reg(32'h10000410+4*word_index,performance_values[word_index*32+:32]);
            end
            if(differential_cycles<90000) $fatal(1,"FAIL banked missing differential coverage");
            $display("PASS banked differential cycles=%0d exhaustive_low_addresses=2048 high_bit_alias_reads=10752 snapshots=16",differential_cycles);
        end
    endtask

    integer timer_carry16=0,timer_carry32=0,timer_carry48=0,timer_wrap64=0;
    reg [63:0] previous_timer=0;
    always @(negedge clk) begin
        #2;
        if(rst_n && timer_value==previous_timer+64'd1) begin
            if(&previous_timer[15:0]) timer_carry16=timer_carry16+1;
            if(&previous_timer[31:0]) timer_carry32=timer_carry32+1;
            if(&previous_timer[47:0]) timer_carry48=timer_carry48+1;
            if(&previous_timer[63:0]) timer_wrap64=timer_wrap64+1;
        end
        previous_timer=timer_value;
    end
    task exercise_timer_prefix;
        reg [63:0] target;
        reg [31:0] random_word;
        begin
            for(integer boundary=8;boundary<=64;boundary=boundary+1) begin
                target=(64'd1<<boundary)-64'd16;
                write_reg(32'h10000300,0,15);
                write_reg(32'h10000304,target[63:32],15);
                write_reg(32'h10000300,target[31:0],15);
                repeat(40) @(negedge clk);
            end
            random_word=32'h6c8e9cf5;
            for(integer trial=0;trial<512;trial=trial+1) begin
                random_word={random_word[30:0],random_word[31]^random_word[21]^random_word[1]^random_word[0]};
                write_reg(32'h10000300+4*(trial%4),random_word,4'(trial%16));
                repeat(3) @(negedge clk);
            end
            check(timer_carry16>0 && timer_carry32>0 && timer_carry48>0 && timer_wrap64>0,"all timer chunk carry boundaries");
            $display("PASS timer prefix boundaries=57 partial_writes=512 carry16=%0d carry32=%0d carry48=%0d wrap64=%0d",timer_carry16,timer_carry32,timer_carry48,timer_wrap64);
        end
    endtask
