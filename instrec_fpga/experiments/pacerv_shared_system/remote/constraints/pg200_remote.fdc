# PG200 remote lab pins; 125 MHz CPU and DDR user logic share a clock.
# The 27 MHz domain supplies startup reset only; release is IP-synchronized.
create_clock -name {board_clk27} [get_ports {board_clk27}] -period {37.037} -waveform {0.000 18.519}
set_clock_groups -name board_boot -asynchronous -group [get_clocks {board_clk27}]
define_attribute {p:board_clk27} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:board_clk27} {PAP_IO_LOC} {D18}
define_attribute {p:board_clk27} {PAP_IO_VCCIO} {3.3}
define_attribute {p:board_clk27} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:board_clk27} {PAP_IO_NONE} {TRUE}
define_attribute {p:resetn} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:resetn} {PAP_IO_LOC} {C22}
define_attribute {p:resetn} {PAP_IO_VCCIO} {3.3}
define_attribute {p:resetn} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:resetn} {PAP_IO_NONE} {TRUE}
define_attribute {p:uart_tx} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:uart_tx} {PAP_IO_LOC} {AB26}
define_attribute {p:uart_tx} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_tx} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:uart_tx} {PAP_IO_NONE} {TRUE}
define_attribute {p:uart_tx} {PAP_IO_DRIVE} {8}
define_attribute {p:uart_tx} {PAP_IO_SLEW} {SLOW}
