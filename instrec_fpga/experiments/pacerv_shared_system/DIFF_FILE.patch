+                ex_valid<=0; mem_valid<=1; mem_sent<=early_data_request && d_req_ready;
+                mem_pc<=ex_pc; mem_instruction<=ex_instruction; mem_next_pc<=actual_next;
+                mem_sequential_prediction_miss<=sequential_prediction_miss;
+                mem_target_prediction_miss<=ex_decode.is_jalr ? indirect_prediction_miss : relative_prediction_miss;
+                mem_result<=execute_result; mem_rd<=ex_rd; mem_writes<=ex_decode.writes_rd;
+                mem_forward_candidate<=ex_decode.writes_rd && ex_rd!=0 && !execute_exception;
+                mem_address<=effective_address; mem_store_data<=forwarded_b << {effective_address[1:0],3'b0};
+                mem_strobe<=execute_strobe; mem_funct3<=ex_instruction[14:12]; mem_load_route<=decode_load_route(ex_instruction[14:12],effective_address[1:0]);
+                mem_load<=ex_decode.is_load; mem_store<=ex_decode.is_store;
+                mem_exception<=execute_exception; mem_cause<=execute_cause; mem_early_redirect<=ex_redirect;
+                mem_csr<=ex_decode.is_csr; mem_csr_write<=csr_write_intent; mem_csr_data<=csr_new_data;
+                mem_mret<=ex_decode.is_mret; mem_fence_i<=ex_decode.is_fence_i;
+                mem_branch<=ex_decode.is_branch || ex_decode.is_jal || ex_decode.is_jalr;
+                mem_conditional<=ex_decode.is_branch; mem_taken<=branch_taken; mem_target<=branch_target;
+            end
+            if(id_fire) begin
+                if(ex_fire) begin
+                    mem_match_a<=id_rs1==ex_rd;
+                    mem_match_b<=id_rs2==ex_rd;
+                end else begin
+                    mem_match_a<=id_rs1==mem_rd;
+                    mem_match_b<=id_rs2==mem_rd;
+                end
+            end else if(ex_fire) begin
+                mem_match_a<=ex_rs1==ex_rd;
+                mem_match_b<=ex_rs2==ex_rd;
+            end
+            if(id_fire) begin
+                id_valid<=0; ex_valid<=1; ex_pc<=id_pc; ex_instruction<=id_instruction; ex_prediction<=id_zero_resolve ? id_zero_next : id_prediction;
+                ex_length<=id_length;
+                ex_error<=id_error; ex_decode<=id_decode; ex_rd<=id_rd;
+                ex_relative_target<=id_pc+id_decode.immediate;
+            end
+            if(id_payload_load) begin
+                id_pc<=if_pc; id_instruction<=if_normalized_instruction; id_prediction<=if_prediction; id_length<=if_length; id_error<=if_error;
+            end
+            if(if_fire) begin
+                if_valid<=0; id_valid<=1;
+            end
+            if(frontend_fire) begin
+                if_valid<=1; if_pc<=frontend_pc; if_instruction<=frontend_instruction; if_prediction<=frontend_prediction;
+                if_length<=frontend_length; if_error<=frontend_out_error;
+            end
+            if(frontend_barrier) begin
+                if_valid<=0; id_valid<=0; ex_valid<=0;
+            end
+            if(frontend_flush) begin
+                if_valid<=0; id_valid<=0;
+                if(mem_flush || ex_redirect) ex_valid<=0;
+            end
+        end
+    end
+endmodule
diff --git a/instrec_fpga/src/cpu/vendor/pacerv_h3/rv32_decode.sv b/instrec_fpga/src/cpu/vendor/pacerv_h3/rv32_decode.sv
new file mode 100644
index 0000000..dfaf4e0
--- /dev/null
+++ b/instrec_fpga/src/cpu/vendor/pacerv_h3/rv32_decode.sv
@@ -0,0 +1,121 @@
+`timescale 1ns/1ps
+module rv32_decode #(
+    parameter integer ENABLE_M=0
+) (
+    input  wire [31:0] instruction,
+    output wire [4:0] rs1,
+    output wire [4:0] rs2,
+    output wire [4:0] rd,
+    output reg uses_rs1,
+    output reg uses_rs2,
+    output reg writes_rd,
+    output reg [31:0] immediate,
+    output reg [3:0] alu_op,
+    output reg alu_immediate,
+    output reg is_lui,
+    output reg is_auipc,
+    output reg is_branch,
+    output reg is_jal,
+    output reg is_jalr,
+    output reg is_load,
+    output reg is_store,
+    output reg is_fence,
+    output reg is_fence_i,
+    output reg is_csr,
+    output reg is_ecall,
+    output reg is_ebreak,
+    output reg is_mret,
+    output reg is_wfi,
+    output reg illegal
+);
+    localparam [3:0] ALU_ADD=0, ALU_SUB=1, ALU_SLL=2, ALU_SLT=3,
+        ALU_SLTU=4, ALU_XOR=5, ALU_SRL=6, ALU_SRA=7, ALU_OR=8, ALU_AND=9;
+    wire [6:0] opcode = instruction[6:0];
+    wire [2:0] funct3 = instruction[14:12];
+    wire [6:0] funct7 = instruction[31:25];
+    assign rs1 = instruction[19:15];
+    assign rs2 = instruction[24:20];
+    assign rd = instruction[11:7];
+    always @* begin
+        uses_rs1=0; uses_rs2=0; writes_rd=0; immediate=0;
+        alu_op=ALU_ADD; alu_immediate=0;
+        is_lui=0; is_auipc=0; is_branch=0; is_jal=0; is_jalr=0;
+        is_load=0; is_store=0; is_fence=0; is_fence_i=0;
+        is_csr=0; is_ecall=0; is_ebreak=0; is_mret=0; is_wfi=0;
+        illegal=0;
+        case (opcode)
+            7'h37: begin
+                is_lui=1; writes_rd=1; immediate={instruction[31:12],12'b0};
+            end
+            7'h17: begin
+                is_auipc=1; writes_rd=1; immediate={instruction[31:12],12'b0};
+            end
+            7'h6f: begin
+                is_jal=1; writes_rd=1;
+                immediate={{11{instruction[31]}},instruction[31],instruction[19:12],instruction[20],instruction[30:21],1'b0};
+            end
+            7'h67: begin
+                is_jalr=1; writes_rd=1; uses_rs1=1;
+                immediate={{20{instruction[31]}},instruction[31:20]};
+                illegal=(funct3!=0);
+            end
+            7'h63: begin
+                is_branch=1; uses_rs1=1; uses_rs2=1;
+                immediate={{19{instruction[31]}},instruction[31],instruction[7],instruction[30:25],instruction[11:8],1'b0};
+                illegal=(funct3==2 || funct3==3);
+            end
+            7'h03: begin
+                is_load=1; writes_rd=1; uses_rs1=1; alu_immediate=1;
+                immediate={{20{instruction[31]}},instruction[31:20]};
+                illegal=!(funct3==0 || funct3==1 || funct3==2 || funct3==4 || funct3==5);
+            end
+            7'h23: begin
+                is_store=1; uses_rs1=1; uses_rs2=1; alu_immediate=1;
+                immediate={{20{instruction[31]}},instruction[31:25],instruction[11:7]};
+                illegal=(funct3>2);
+            end
+            7'h13,7'h33: begin
+                writes_rd=1; uses_rs1=1;
+                uses_rs2=(opcode==7'h33); alu_immediate=(opcode==7'h13);
+                immediate={{20{instruction[31]}},instruction[31:20]};
+                case (funct3)
+                    0: alu_op=(opcode==7'h33 && funct7==7'h20) ? ALU_SUB : ALU_ADD;
+                    1: alu_op=ALU_SLL;
+                    2: alu_op=ALU_SLT;
+                    3: alu_op=ALU_SLTU;
+                    4: alu_op=ALU_XOR;
+                    5: alu_op=instruction[30] ? ALU_SRA : ALU_SRL;
+                    6: alu_op=ALU_OR;
+                    7: alu_op=ALU_AND;
+                endcase
+                if (opcode==7'h33)
+                    illegal=!(funct7==0 || (ENABLE_M!=0 && funct7==1) || (funct7==7'h20 && (funct3==0 || funct3==5)));
+                else if (funct3==1) illegal=(funct7!=0);
+                else if (funct3==5) illegal=!(funct7==0 || funct7==7'h20);
+            end
+            7'h0f: begin
+                is_fence=(funct3==0); is_fence_i=(funct3==1);
+                illegal=!(is_fence || is_fence_i);
+            end
+            7'h73: begin
+                if (funct3==0) begin
+                    case (instruction)
+                        32'h00000073: is_ecall=1;
+                        32'h00100073: is_ebreak=1;
+                        32'h30200073: is_mret=1;
+                        32'h10500073: is_wfi=1;
+                        default: illegal=1;
+                    endcase
+                end else if (funct3!=4) begin
+                    is_csr=1; writes_rd=1; uses_rs1=!funct3[2];
+                    immediate={27'b0,rs1};
+                end else illegal=1;
+            end
+            default: illegal=1;
+        endcase
+        if (illegal) begin
+            writes_rd=0; is_store=0; is_load=0; is_csr=0;
+            is_branch=0; is_jal=0; is_jalr=0;
+        end
+    end
+endmodule
diff --git a/instrec_fpga/src/cpu/vendor/pacerv_h3/rv32_machine.sv b/instrec_fpga/src/cpu/vendor/pacerv_h3/rv32_machine.sv
new file mode 100644
index 0000000..8201a75
--- /dev/null
+++ b/instrec_fpga/src/cpu/vendor/pacerv_h3/rv32_machine.sv
@@ -0,0 +1,103 @@
+`timescale 1ns/1ps
+module rv32_machine #(
+    parameter integer ENABLE_M=0,
+    parameter integer ENABLE_C=0
+) (
+    input wire clk,
+    input wire rst_n,
+    input wire retire,
+    input wire [63:0] timer_value,
+    input wire irq_external,
+    input wire irq_software,
+    input wire irq_timer,
+    input wire [11:0] read_address,
+    input wire read_write_intent,
+    output reg [31:0] read_data,
+    output reg read_illegal,
+    input wire write_valid,
+    input wire [11:0] write_address,
+    input wire [31:0] write_data,
+    input wire trap_enter,
+    input wire [31:0] trap_pc,
+    input wire [31:0] trap_cause,
+    input wire [31:0] trap_value,
+    input wire return_from_trap,
+    output wire [31:0] return_pc,
+    output wire [31:0] trap_target,
+    output wire interrupt_pending,
+    output wire [31:0] interrupt_cause,
+    output wire [63:0] cycle_count,
+    output wire [63:0] retired_count
+);
+    reg machine_ie,machine_pie;
+    reg [31:0] mtvec,mscratch,mepc,mcause,mtval,mie,mcounteren;
+    reg [63:0] mcycle,minstret;
+    wire [1:0] unused_trap_alignment=trap_pc[1:0];
+    wire [31:0] mip={20'b0,irq_external,3'b0,irq_timer,3'b0,irq_software,3'b0};
+    wire [31:0] pending=mip & mie;
+    wire [31:0] mstatus={19'b0,2'b11,3'b0,machine_pie,3'b0,machine_ie,3'b0};
+    assign cycle_count=mcycle;
+    assign retired_count=minstret;
+    assign return_pc=mepc;
+    assign interrupt_pending=machine_ie && |pending;
+    assign interrupt_cause=pending[11] ? 32'h8000000b : pending[3] ? 32'h80000003 : 32'h80000007;
+    (* syn_keep=1 *) wire [31:0] trap_vector_sum={mtvec[31:2],2'b0} + ((mtvec[1:0]==1 && trap_cause[31]) ? {25'b0,trap_cause[4:0],2'b0} : 32'b0);
+    assign trap_target=trap_vector_sum;
+    always @* begin
+        read_illegal=0;
+        case(read_address)
+            12'h300: read_data=mstatus;
+            12'h301: read_data=ENABLE_C!=0 ? (ENABLE_M!=0 ? 32'h40001104 : 32'h40000104) :
+                (ENABLE_M!=0 ? 32'h40001100 : 32'h40000100);
+            12'h304: read_data=mie;
+            12'h305: read_data=mtvec;
+            12'h306: read_data=mcounteren;
+            12'h340: read_data=mscratch;
+            12'h341: read_data=mepc;
+            12'h342: read_data=mcause;
+            12'h343: read_data=mtval;
+            12'h344: read_data=mip;
+            12'hb00,12'hc00: read_data=mcycle[31:0];
+            12'hb80,12'hc80: read_data=mcycle[63:32];
+            12'hb02,12'hc02: read_data=minstret[31:0];
+            12'hb82,12'hc82: read_data=minstret[63:32];
+            12'hc01: read_data=timer_value[31:0];
+            12'hc81: read_data=timer_value[63:32];
+            12'hf11,12'hf12,12'hf13,12'hf14: read_data=0;
+            default: begin read_data=0; read_illegal=1; end
+        endcase
+        if(read_write_intent && read_address[11:10]==2'b11) read_illegal=1;
+    end
+    always @(posedge clk or negedge rst_n) begin
+        if(!rst_n) begin
+            machine_ie<=0; machine_pie<=0;
+            mtvec<=0; mscratch<=0; mepc<=0; mcause<=0; mtval<=0; mie<=0; mcounteren<=0;
+            mcycle<=0; minstret<=0;
+        end else begin
+            mcycle<=mcycle+64'd1;
+            if(retire) minstret<=minstret+64'd1;
+            if(write_valid) begin
+                case(write_address)
+                    12'h300: begin machine_ie<=write_data[3]; machine_pie<=write_data[7]; end
+                    12'h304: mie<=write_data & 32'h00000888;
+                    12'h305: mtvec<={write_data[31:2],1'b0,(write_data[1:0]==1)};
+                    12'h306: mcounteren<=write_data & 32'h7;
+                    12'h340: mscratch<=write_data;
+                    12'h341: mepc<=ENABLE_C!=0 ? {write_data[31:1],1'b0} : {write_data[31:2],2'b0};
+                    12'h342: mcause<=write_data;
+                    12'h343: mtval<=write_data;
+                    12'hb00: mcycle<={mcycle[63:32],write_data};
+                    12'hb80: mcycle<={write_data,mcycle[31:0]};
+                    12'hb02: minstret<={minstret[63:32],write_data};
+                    12'hb82: minstret<={write_data,minstret[31:0]};
+                    default: begin end
+                endcase
+            end
+            if(return_from_trap) begin machine_ie<=machine_pie; machine_pie<=1; end
+            if(trap_enter) begin
+                mepc<=ENABLE_C!=0 ? {trap_pc[31:1],1'b0} : {trap_pc[31:2],2'b0}; mcause<=trap_cause; mtval<=trap_value;
+                machine_pie<=machine_ie; machine_ie<=0;
+            end
+        end
+    end
+endmodule
diff --git a/instrec_fpga/src/cpu/vendor/pacerv_h3/rv32_muldiv.sv b/instrec_fpga/src/cpu/vendor/pacerv_h3/rv32_muldiv.sv
new file mode 100644
index 0000000..397f819
--- /dev/null
+++ b/instrec_fpga/src/cpu/vendor/pacerv_h3/rv32_muldiv.sv
@@ -0,0 +1,121 @@
+`timescale 1ns/1ps
+module rv32_muldiv #(parameter integer PRECOMPUTE=0) (
+    input wire clk,
+    input wire rst_n,
+    input wire cancel,
+    input wire req_valid,
+    input wire req_precomputed,
+    output wire req_ready,
+    input wire [2:0] req_operation,
+    input wire [31:0] req_operand_a,
+    input wire [31:0] req_operand_b,
+    output wire rsp_valid,
+    output wire rsp_available,
+    input wire rsp_ready,
+    output wire [31:0] rsp_data
+);
+    localparam [2:0] IDLE=0,PRODUCT=2,DIVIDE=3,DIVISION_RESULT=4,RESPONSE=5;
+    reg [2:0] state;
+    reg [2:0] operation;
+    reg [31:0] product_low_low,product_high_high;
+    reg signed [33:0] product_low_high,product_high_low;
+    wire signed [16:0] request_low_a={1'b0,req_operand_a[15:0]};
+    wire signed [16:0] request_low_b={1'b0,req_operand_b[15:0]};
+    wire signed [16:0] request_high_a={((req_operation==1 || req_operation==2) && req_operand_a[31]),req_operand_a[31:16]};
+    wire signed [16:0] request_high_b={(req_operation==1 && req_operand_b[31]),req_operand_b[31:16]};
+    wire [47:0] product_cross_a={{14{product_low_high[33]}},product_low_high};
+    wire [47:0] product_cross_b={{14{product_high_low[33]}},product_high_low};
+    wire [47:0] product_outer={product_high_high,product_low_low[31:16]};
+    wire [47:0] product_sum=product_cross_a^product_cross_b^product_outer;
+    wire [47:0] product_carry=((product_cross_a & product_cross_b) |
+        (product_cross_a & product_outer) | (product_cross_b & product_outer)) << 1;
+    wire [47:0] product_upper=product_sum+product_carry;
+    wire [63:0] product={product_upper,product_low_low[15:0]};
+    reg [31:0] response_data;
+    reg [31:0] divisor,quotient;
+    reg [31:0] remainder;
+    reg [4:0] division_step;
+    reg quotient_negative,remainder_negative;
+    wire signed_division=!req_operation[0];
+    wire negative_a=signed_division && req_operand_a[31];
+    wire negative_b=signed_division && req_operand_b[31];
+    wire [32:0] trial_remainder={remainder[31:0],quotient[31]};
+    // The extra leading bit exposes borrow while retaining the full trial value.
+    wire [33:0] trial_difference={1'b0,trial_remainder}-{2'b0,divisor};
+    wire unused_trial_difference_high=trial_difference[32];
+    wire subtract_divisor=!trial_difference[33];
+    assign req_ready=state==IDLE && !cancel;
+    wire early_product=state==PRODUCT && (operation==0 || operation==3);
+    wire immediate_product=PRECOMPUTE!=0 && state==IDLE && req_valid && req_precomputed && req_operation==0;
+    assign rsp_available=state==RESPONSE || early_product ||
+        (PRECOMPUTE!=0 && state==IDLE && req_precomputed && req_operation==0);
+    assign rsp_valid=(state==RESPONSE || early_product || immediate_product) && !cancel;
+    assign rsp_data=immediate_product ? product[31:0] :
+        (early_product ? (operation==0 ? product[31:0] : product[63:32]) : response_data);
+    always @(posedge clk or negedge rst_n) begin
+        if(!rst_n) begin
+            product_low_low<=0; product_low_high<=0; product_high_low<=0; product_high_high<=0;
+        end else if(state==IDLE) begin
+            product_low_low<=req_operand_a[15:0]*req_operand_b[15:0];
+            product_low_high<=request_low_a*request_high_b;
+            product_high_low<=request_high_a*request_low_b;
+            product_high_high<=request_high_a*request_high_b;
+        end
+    end
+    always @(posedge clk or negedge rst_n) begin
+        if(!rst_n) begin
+            state<=IDLE; operation<=0;
+            divisor<=0; quotient<=0; remainder<=0; division_step<=0;
+            quotient_negative<=0; remainder_negative<=0; response_data<=0;
+        end else if(cancel) begin
+            state<=IDLE;
+        end else begin
+            if(state==IDLE) begin
+                operation<=req_operation;
+                divisor<=negative_b ? -req_operand_b : req_operand_b;
+                quotient<=negative_a ? -req_operand_a : req_operand_a;
+                remainder<=0; division_step<=0;
+                quotient_negative<=negative_a ^ negative_b;
+                remainder_negative<=negative_a;
+                response_data<=req_operation[1] ? req_operand_a : 32'hffffffff;
+            end
+            case(state)
+                IDLE: if(req_valid) begin
+                    if(immediate_product) begin
+                        if(!rsp_ready) begin
+                            response_data<=product[31:0];
+                            state<=RESPONSE;
+                        end
+                    end else if(!req_operation[2]) begin
+                        state<=PRODUCT;
+                    end else if(req_operand_b==0) begin
+                        state<=RESPONSE;
+                    end else begin
+                        state<=DIVIDE;
+                    end
+                end
+                PRODUCT: begin
+                    if(early_product) begin
+                        if(rsp_ready) state<=IDLE;
+                    end else begin
+                        response_data<=product[63:32];
+                        state<=RESPONSE;
+                    end
+                end
+                DIVIDE: begin
+                    quotient<={quotient[30:0],subtract_divisor};
+                    remainder<=subtract_divisor ? trial_difference[31:0] : trial_remainder[31:0];
+                    division_step<=division_step+1'b1;
+                    if(division_step==31) state<=DIVISION_RESULT;
+                end
+                DIVISION_RESULT: begin
+                    response_data<=operation[1] ? (remainder_negative ? -remainder[31:0] : remainder[31:0]) :
+                        (quotient_negative ? -quotient : quotient);
+                    state<=RESPONSE;
+                end
+                RESPONSE: if(rsp_ready) state<=IDLE;
+                default: state<=IDLE;
+            endcase
+        end
+    end
+endmodule
diff --git a/instrec_fpga/src/cpu/vendor/pacerv_h3/rv32_rvc_expand.sv b/instrec_fpga/src/cpu/vendor/pacerv_h3/rv32_rvc_expand.sv
new file mode 100644
index 0000000..45991e5
--- /dev/null
+++ b/instrec_fpga/src/cpu/vendor/pacerv_h3/rv32_rvc_expand.sv
@@ -0,0 +1,148 @@
+`timescale 1ns/1ps
+module rv32_rvc_expand (
+    input wire [15:0] compressed,
+    output reg [31:0] instruction,
+    output reg illegal
+);
+    wire [1:0] quadrant=compressed[1:0];
+    wire [2:0] funct3=compressed[15:13];
+    wire [4:0] rd=compressed[11:7];
+    wire [4:0] rs2=compressed[6:2];
+    wire [4:0] rd_prime={2'b01,compressed[4:2]};
+    wire [4:0] rs1_prime={2'b01,compressed[9:7]};
+    wire [4:0] rs2_prime={2'b01,compressed[4:2]};
+    wire [4:0] rs2_alt={2'b01,compressed[4:2]};
+    reg [11:0] immediate;
+    reg [12:0] branch_immediate;
+    reg [20:0] jump_immediate;
+    reg [6:0] function7;
+    reg [2:0] function3;
+    reg [31:0] encoded;
+
+    always @* begin
+        instruction=32'h00000013;
+        illegal=0;
+        immediate=0;
+        branch_immediate=0;
+        jump_immediate=0;
+        function7=0;
+        function3=0;
+        encoded=32'h00000013;
+        case(quadrant)
+            2'b00: begin
+                case(funct3)
+                    3'b000: begin
+                        immediate={2'b0,compressed[10:7],compressed[12:11],compressed[5],compressed[6],2'b0};
+                        if(immediate==0) illegal=1;
+                        encoded={immediate,5'd2,3'b000,rd_prime,7'h13};
+                    end
+                    3'b010: begin
+                        immediate={5'b0,compressed[5],compressed[12:10],compressed[6],2'b0};
+                        encoded={immediate,rs1_prime,3'b010,rd_prime,7'h03};
+                    end
+                    3'b110: begin
+                        immediate={5'b0,compressed[5],compressed[12:10],compressed[6],2'b0};
+                        encoded={immediate[11:5],rs2_prime,rs1_prime,3'b010,immediate[4:0],7'h23};
+                    end
+                    default: illegal=1;
+                endcase
+            end
+            2'b01: begin
+                case(funct3)
+                    3'b000: begin
+                        immediate={{6{compressed[12]}},compressed[12],compressed[6:2]};
+                        encoded={immediate,rd,3'b000,rd,7'h13};
+                    end
+                    3'b001: begin
+                        jump_immediate={{9{compressed[12]}},compressed[12],compressed[8],compressed[10:9],compressed[6],compressed[7],compressed[2],compressed[11],compressed[5:3],1'b0};
+                        encoded={jump_immediate[20],jump_immediate[10:1],jump_immediate[11],jump_immediate[19:12],5'd1,7'h6f};
+                    end
+                    3'b010: begin
+                        immediate={{6{compressed[12]}},compressed[12],compressed[6:2]};
+                        encoded={immediate,5'd0,3'b000,rd,7'h13};
+                    end
+                    3'b011: begin
+                        if(rd==5'd2) begin
+                            immediate={{2{compressed[12]}},compressed[12],compressed[4:3],compressed[5],compressed[2],compressed[6],4'b0};
+                            if(immediate==0) illegal=1;
+                            encoded={immediate,5'd2,3'b000,5'd2,7'h13};
+                        end else begin
+                            if({compressed[12],compressed[6:2]}==0) illegal=1;
+                            encoded={{14{compressed[12]}},compressed[12],compressed[6:2],rd,7'h37};
+                        end
+                    end
+                    3'b100: begin
+                        case(compressed[11:10])
+                            2'b00: begin
+                                if(compressed[12]) illegal=1;
+                                immediate={7'b0,compressed[6:2]};
+                                encoded={7'b0000000,immediate[4:0],rs1_prime,3'b101,rs1_prime,7'h13};
+                            end
+                            2'b01: begin
+                                if(compressed[12]) illegal=1;
+                                immediate={7'b0,compressed[6:2]};
+                                encoded={7'b0100000,immediate[4:0],rs1_prime,3'b101,rs1_prime,7'h13};
+                            end
+                            2'b10: begin
+                                immediate={{6{compressed[12]}},compressed[12],compressed[6:2]};
+                                encoded={immediate,rs1_prime,3'b111,rs1_prime,7'h13};
+                            end
+                            2'b11: begin
+                                if(compressed[12]) illegal=1;
+                                function7=compressed[6:5]==2'b00 ? 7'b0100000 : 7'b0000000;
+                                function3=compressed[6:5]==2'b00 ? 3'b000 :
+                                    compressed[6:5]==2'b01 ? 3'b100 :
+                                    compressed[6:5]==2'b10 ? 3'b110 : 3'b111;
+                                encoded={function7,rs2_alt,rs1_prime,function3,rs1_prime,7'h33};
+                            end
+                        endcase
+                    end
+                    3'b101: begin
+                        jump_immediate={{9{compressed[12]}},compressed[12],compressed[8],compressed[10:9],compressed[6],compressed[7],compressed[2],compressed[11],compressed[5:3],1'b0};
+                        encoded={jump_immediate[20],jump_immediate[10:1],jump_immediate[11],jump_immediate[19:12],5'd0,7'h6f};
+                    end
+                    3'b110: begin
+                        branch_immediate={{4{compressed[12]}},compressed[12],compressed[6:5],compressed[2],compressed[11:10],compressed[4:3],1'b0};
+                        encoded={branch_immediate[12],branch_immediate[10:5],5'd0,rs1_prime,3'b000,branch_immediate[4:1],branch_immediate[11],7'h63};
+                    end
+                    3'b111: begin
+                        branch_immediate={{4{compressed[12]}},compressed[12],compressed[6:5],compressed[2],compressed[11:10],compressed[4:3],1'b0};
+                        encoded={branch_immediate[12],branch_immediate[10:5],5'd0,rs1_prime,3'b001,branch_immediate[4:1],branch_immediate[11],7'h63};
+                    end
+                endcase
+            end
+            2'b10: begin
+                case(funct3)
+                    3'b000: begin
+                        if(compressed[12]) illegal=1;
+                        immediate={7'b0,compressed[6:2]};
+                        encoded={7'b0000000,immediate[4:0],rd,3'b001,rd,7'h13};
+                    end
+                    3'b010: begin
+                        if(rd==0) illegal=1;
+                        immediate={4'b0,compressed[3:2],compressed[12],compressed[6:4],2'b0};
+                        encoded={immediate,5'd2,3'b010,rd,7'h03};
+                    end
+                    3'b100: begin
+                        if(!compressed[12]) begin
+                            if(rs2==0 && rd==0) illegal=1;
+                            else if(rs2==0) encoded={12'b0,rd,3'b000,5'd0,7'h67};
+                            else encoded={7'b0000000,rs2,5'd0,3'b000,rd,7'h33};
+                        end else begin
+                            if(rd==0 && rs2==0) encoded=32'h00100073;
+                            else if(rs2==0) encoded={12'b0,rd,3'b000,5'd1,7'h67};
+                            else encoded={7'b0000000,rs2,rd,3'b000,rd,7'h33};
+                        end
+                    end
+                    3'b110: begin
+                        immediate={4'b0,compressed[8:7],compressed[12:9],2'b0};
+                        encoded={immediate[11:5],rs2,5'd2,3'b010,immediate[4:0],7'h23};
+                    end
+                    default: illegal=1;
+                endcase
+            end
+            default: illegal=1;
+        endcase
+        if(!illegal) instruction=encoded;
+    end
+endmodule
diff --git a/instrec_fpga/src/cpu/vendor/pacerv_h3/rv32_rvc_frontend.sv b/instrec_fpga/src/cpu/vendor/pacerv_h3/rv32_rvc_frontend.sv
new file mode 100644
index 0000000..20022a3
--- /dev/null
+++ b/instrec_fpga/src/cpu/vendor/pacerv_h3/rv32_rvc_frontend.sv
@@ -0,0 +1,211 @@
+`timescale 1ns/1ps
+module rv32_rvc_frontend #(
+    parameter [31:0] RESET_VECTOR=32'h00000000,
+    parameter integer ENABLE_C=1,
+    parameter integer ADDRESS_BITS=32,
+    parameter integer USE_PRECOMPUTED_REDIRECT_PAIR_ADDRESS=0,
+    parameter integer USE_REDIRECT_ADDRESS_SELECT=0
+) (
+    input wire clk, rst_n,
+    input wire invalidate,
+    input wire redirect_valid,
+    input wire redirect_address_select,
+    input wire redirect_in_range,
+    input wire [31:0] redirect_pc,
+    input wire [31:0] redirect_pair_pc,
+    input wire predicted_taken,
+    input wire [31:0] predicted_target,
+    output wire [31:0] predictor_pc,
+    output wire out_valid,
+    input wire out_ready,
+    output wire [31:0] out_pc, out_instruction, out_prediction,
+    output wire [2:0] out_length,
+    output wire out_error,
+    output wire buffered_valid,
+    output wire [31:0] buffered_instruction,
+    output wire [2:0] buffered_length,
+    output wire i_req_valid,
+    input wire i_req_ready,
+    output wire [31:0] i_req_address,
+    output wire [31:0] i_req_pair_address,
+    input wire i_rsp_valid,
+    output wire i_rsp_ready,
+    input wire [31:0] i_rsp_data,
+    input wire [31:0] i_rsp_pair_data,
+    input wire [1:0] i_rsp_is_c,i_rsp_pair_is_c,
+    input wire i_rsp_pair_valid,
+    input wire i_rsp_error
+);
+    reg [31:0] pc;
+    reg word0_valid,word1_valid;
+    reg [ADDRESS_BITS-1:0] word0_tag,word1_tag;
+    wire [31:0] word0_address={{(32-ADDRESS_BITS){1'b0}},word0_tag};
+    wire [31:0] word1_address={{(32-ADDRESS_BITS){1'b0}},word1_tag};
+    reg [31:0] word0_data,word1_data;
+    reg [1:0] word0_is_c,word1_is_c;
+    reg word0_error,word1_error;
+    reg request_pending,request_discard;
+    reg [ADDRESS_BITS-1:0] request_tag;
+    wire [31:0] request_address={{(32-ADDRESS_BITS){1'b0}},request_tag};
+    wire response_fire=request_pending && i_rsp_valid;
+    wire response_usable=response_fire && !request_discard && !invalidate;
+    wire [31:0] aligned_pc={pc[31:2],2'b0};
+    wire [31:0] following_address=aligned_pc+32'd4;
+    wire current_range_error=(pc >> ADDRESS_BITS)!=0;
+    wire following_range_error=(following_address >> ADDRESS_BITS)!=0;
+    // Preserve the address-range carry without a full-width stored-tag adder.
+    localparam integer PAIR_ADDRESS_BITS=ADDRESS_BITS<32 ? ADDRESS_BITS+1 : 32;
+    wire [PAIR_ADDRESS_BITS-1:0] compact_pair_address=
+        {{(PAIR_ADDRESS_BITS-ADDRESS_BITS){1'b0}},request_tag}+
+        {{(PAIR_ADDRESS_BITS-3){1'b0}},3'd4};
+    wire [31:0] pair_address={{(32-PAIR_ADDRESS_BITS){1'b0}},compact_pair_address};
+    // Stored demand/buffer tags have zero upper address bits. Share the
+    // upper-range qualification instead of repeating full-width equality.
+    wire request_current_match=!current_range_error && request_tag==aligned_pc[ADDRESS_BITS-1:0];
+    wire request_following_match=!following_range_error && request_tag==following_address[ADDRESS_BITS-1:0];
+    wire word0_current_match=!current_range_error && word0_tag==aligned_pc[ADDRESS_BITS-1:0];
+    wire word1_current_match=!current_range_error && word1_tag==aligned_pc[ADDRESS_BITS-1:0];
+    wire current_pair=!request_current_match && i_rsp_pair_valid && pair_address==aligned_pc;
+    wire following_pair=!request_following_match && i_rsp_pair_valid && pair_address==following_address;
+    wire current_pending=request_pending && !request_discard && (request_current_match || current_pair);
+    wire following_pending=request_pending && !request_discard && (request_following_match || following_pair);
+    wire current_response=response_usable && current_pending;
+    wire following_response=response_usable && following_pending;
+    wire current_buffer_valid=pc[2] ? word1_valid && word1_current_match : word0_valid && word0_current_match;
+    wire following_buffer_valid=!following_range_error && (pc[2] ? word0_valid && word0_tag==following_address[ADDRESS_BITS-1:0] : word1_valid && word1_tag==following_address[ADDRESS_BITS-1:0]);
+    wire current_valid=current_range_error || current_response || current_buffer_valid;
+    wire following_valid=following_range_error || following_response || following_buffer_valid;
+    // A separate registered-word cone for static prediction. No response
+    // data, response error, or response-valid signal enters these outputs.
+    wire [31:0] buffered_current=pc[2] ? word1_data : word0_data;
+    wire [31:0] buffered_following=pc[2] ? word0_data : word1_data;
+    wire [1:0] buffered_current_is_c=pc[2] ? word1_is_c : word0_is_c;
+    wire buffered_compressed=ENABLE_C!=0 && buffered_current_is_c[pc[1]];
+    wire buffered_straddles=ENABLE_C!=0 && pc[1] && !buffered_compressed;
+    wire buffered_current_error=pc[2] ? word1_error : word0_error;
+    wire buffered_following_error=pc[2] ? word0_error : word1_error;
+    assign buffered_valid=current_buffer_valid && !buffered_current_error &&
+        (!buffered_straddles || (following_buffer_valid && !buffered_following_error));
+    assign buffered_length=buffered_compressed ? 3'd2 : 3'd4;
+    wire [15:0] buffered_low=ENABLE_C!=0 && pc[1] ? buffered_current[31:16] : buffered_current[15:0];
+    wire [15:0] buffered_high=buffered_compressed ? 16'b0 :
+        buffered_straddles ? buffered_following[15:0] : buffered_current[31:16];
+    assign buffered_instruction={buffered_high,buffered_low};
+    wire [31:0] current_data=current_buffer_valid ? (pc[2] ? word1_data : word0_data) : current_pair ? i_rsp_pair_data : i_rsp_data;
+    wire [31:0] following_data=following_buffer_valid ? (pc[2] ? word0_data : word1_data) : following_pair ? i_rsp_pair_data : i_rsp_data;
+    wire current_error=current_range_error || (current_buffer_valid ? (pc[2] ? word1_error : word0_error) : i_rsp_error);
+    wire following_error=following_range_error || (following_buffer_valid ? (pc[2] ? word0_error : word1_error) : i_rsp_error);
+    wire [15:0] halfword=pc[1] ? current_data[31:16] : current_data[15:0];
+    wire [1:0] current_is_c=current_buffer_valid ? (pc[2] ? word1_is_c : word0_is_c) :
+        current_pair ? i_rsp_pair_is_c : i_rsp_is_c;
+    wire compressed=ENABLE_C!=0 && current_is_c[pc[1]];
+    wire straddles=ENABLE_C!=0 && pc[1] && !compressed;
+    wire instruction_available=current_valid && (current_error || !straddles || following_valid);
+    wire output_fire=out_valid && out_ready;
+    wire [29:0] incremented_word=pc[31:2]+30'd1;
+    wire [31:0] next_pc={(pc[1] || !compressed ? incremented_word : pc[31:2]),pc[1]^compressed,pc[0]};
+    wire [31:0] predicted_pc=predicted_taken ? predicted_target : next_pc;
+    function automatic staged(input [31:0] address);
+        begin
+            // A companion can be one word beyond the stored address width.
+            // Keep its full-width comparison outside the demand range guard.
+            staged=((address>>ADDRESS_BITS)==0 &&
+                ((address[2] ? word1_valid && word1_tag==address[ADDRESS_BITS-1:0] : word0_valid && word0_tag==address[ADDRESS_BITS-1:0]) ||
+                 (request_pending && !request_discard && request_tag==address[ADDRESS_BITS-1:0]))) ||
+                (request_pending && !request_discard && i_rsp_pair_valid && pair_address==address);
+        end
+    endfunction
+    wire [31:0] ahead_address=aligned_pc+32'd8;
+    wire current_staged=staged(aligned_pc);
+    wire following_staged=staged(following_address);
+    wire ahead_staged=staged(ahead_address);
+    wire advance_word=pc[1] || !compressed;
+    wire [31:0] hold_request=current_staged ? following_address : aligned_pc;
+    wire hold_needed=!current_staged || !following_staged;
+    wire [31:0] sequential_request=pc[1] ? (following_staged ? ahead_address : following_address) : hold_request;
+    wire sequential_needed=pc[1] ? (!following_staged || !ahead_staged) : hold_needed;
+    wire [31:0] target_address={predicted_target[31:2],2'b0};
+    wire release_word1=out_ready && instruction_available && advance_word;
+    wire [31:0] redirect_address={redirect_pc[31:2],2'b0};
+    wire [31:0] accepted_request=predicted_taken ? target_address : sequential_request;
+    wire accepted_needed=predicted_taken || sequential_needed;
+    wire accept_staged=out_ready && current_staged && (!pc[1] || compressed || following_staged);
+    wire redirect_request_valid=redirect_in_range;
+    wire accepted_request_valid=accepted_needed && (accepted_request >> ADDRESS_BITS)==0;
+    wire hold_request_valid=hold_needed && (hold_request >> ADDRESS_BITS)==0;
+    wire select_redirect_address=USE_REDIRECT_ADDRESS_SELECT!=0 ? redirect_address_select : redirect_valid;
+    wire [ADDRESS_BITS-1:0] selected_request=select_redirect_address ? redirect_address[ADDRESS_BITS-1:0] :
+        accept_staged ? accepted_request[ADDRESS_BITS-1:0] : hold_request[ADDRESS_BITS-1:0];
+    // Precompute each candidate's companion before the late request selection.
+    wire [31:0] hold_pair_request=current_staged ? ahead_address : following_address;
+    wire [31:0] ahead_pair_address=aligned_pc+32'd12;
+    wire [31:0] sequential_pair_request=pc[1] ?
+        (following_staged ? ahead_pair_address : ahead_address) : hold_pair_request;
+    wire [31:0] target_pair_address=target_address+32'd4;
+    wire [31:0] redirect_pair_address=USE_PRECOMPUTED_REDIRECT_PAIR_ADDRESS!=0 ?
+        redirect_pair_pc : redirect_address+32'd4;
+    wire [31:0] accepted_pair_request=predicted_taken ? target_pair_address : sequential_pair_request;
+    assign i_req_pair_address=select_redirect_address ? redirect_pair_address :
+        accept_staged ? accepted_pair_request : hold_pair_request;
+    assign predictor_pc=pc;
+    assign out_pc=pc;
+    assign out_valid=instruction_available && !redirect_valid && !invalidate;
+    wire [15:0] instruction_low=ENABLE_C!=0 && pc[1] ? current_data[31:16] : current_data[15:0];
+    wire [15:0] instruction_high=compressed ? 16'b0 : straddles ? following_data[15:0] : current_data[31:16];
+    assign out_instruction=out_error ? (current_error ? pc : following_address) : {instruction_high,instruction_low};
+    assign out_length=compressed ? 3'd2 : 3'd4;
+    assign out_prediction=predicted_pc;
+    assign out_error=current_error || (straddles && following_error);
+    assign i_req_valid=!invalidate && (!request_pending || response_fire) &&
+        (redirect_valid ? redirect_request_valid : accept_staged ? accepted_request_valid : hold_request_valid);
+    assign i_req_address={{(32-ADDRESS_BITS){1'b0}},selected_request};
+    assign i_rsp_ready=request_pending;
+    always @(posedge clk or negedge rst_n) begin
+        if(!rst_n) begin
+            pc<=RESET_VECTOR;
+            word0_valid<=0; word1_valid<=0;
+            word0_tag<=0; word1_tag<=0;
+            word0_data<=0; word1_data<=0;
+            word0_is_c<=2'b11; word1_is_c<=2'b11;
+            word0_error<=0; word1_error<=0;
+            request_pending<=0; request_discard<=0; request_tag<=0;
+        end else begin
+            if(redirect_valid) pc<=redirect_pc;
+            else if(output_fire) pc<=predicted_pc;
+            if(response_fire) begin
+                request_pending<=0;
+                request_discard<=0;
+                if(response_usable) begin
+                    if(request_address[2]) begin
+                        word1_valid<=1; word1_tag<=request_tag;
+                        word1_data<=i_rsp_data; word1_error<=i_rsp_error;
+                        word1_is_c<=i_rsp_is_c;
+                        if(i_rsp_pair_valid && (!word0_valid || !word0_current_match || release_word1)) begin
+                            word0_valid<=1; word0_tag<=pair_address[ADDRESS_BITS-1:0];
+                            word0_data<=i_rsp_pair_data; word0_error<=0;
+                            word0_is_c<=i_rsp_pair_is_c;
+                        end
+                    end else begin
+                        word0_valid<=1; word0_tag<=request_tag;
+                        word0_data<=i_rsp_data; word0_error<=i_rsp_error;
+                        word0_is_c<=i_rsp_is_c;
+                        if(i_rsp_pair_valid && (!word1_valid || !word1_current_match || release_word1)) begin
+                            word1_valid<=1; word1_tag<=pair_address[ADDRESS_BITS-1:0];
+                            word1_data<=i_rsp_pair_data; word1_error<=0;
+                            word1_is_c<=i_rsp_pair_is_c;
+                        end
+                    end
+                end
+            end
+            if(invalidate) begin
+                word0_valid<=0; word1_valid<=0;
+                request_discard<=request_pending && !response_fire;
+            end
+            if(i_req_valid && i_req_ready) begin
+                request_pending<=1; request_discard<=0;
+            end
+            if(!request_pending || response_fire)
+                request_tag<=i_req_address[ADDRESS_BITS-1:0];
+        end
+    end
+endmodule
diff --git a/instrec_fpga/src/ctrl/instrec_top.v b/instrec_fpga/src/ctrl/instrec_top.v
index 6bcfefc..26f49d8 100644
--- a/instrec_fpga/src/ctrl/instrec_top.v
+++ b/instrec_fpga/src/ctrl/instrec_top.v
@@ -1,1080 +1,1116 @@
-// -----------------------------------------------------------------------------
-// File    : instrec_top.v
-// Module  : instrec_top
-// Project : InstRec-FPGA (PG2L100H-6IFBG676, PDS 2022.2-SP6.4)
-// Purpose : RV32 control + I2S capture -> CDC -> DDR3 -> NPU -> HDMI
-//           waveform display with the debug / self-test chain
-//           (design doc sections 1.1 / 2.2.1, REQ-VER-001 M0 scope).
-//
-// Clock domains (design doc section 1.2):
-//   clk       27 MHz board crystal (D18), reference of video GPLL
-//   clk_nco   27 MHz audio processing clock (alias of board clk)
-//   pix_clk   148.5 MHz pixel clock (hdmi_tx_if / demo GPLL_B IP)
-//   core_clk  125 MHz DDR3 controller user clock (ddr3_wrapper IP output)
-//
-// Reset tree (design doc section 1.3):
-//   rst_n     asynchronous board reset (KEY0, C22)
-//   rst_sync_nco   clk_nco domain, two-FF synchronous reset release
-//   rst_pix_n      pix_clk domain, sync release (hdmi_tx_if)
-//   rst_sync_core  = rst_n directly; feeds ONLY ddr3_wrapper.resetn.
-//                  Must not depend on core_clk (the IP GPLL produces it,
-//                  so a core_clk-based release counter deadlocks).
-//   core_clk_rst_n core_clk domain, sync release (ddr3_wrapper IP)
-//
-// CDC points (producers synchronize internally, the top level only wires):
-//   * pcm path        clk_nco -> core_clk  : audio_cdc_fifo dual-clock FIFO
-//   * sd_idle         clk_nco -> core_clk  : 2FF inside audio_sink/sys_ctrl
-//   * vsync_pulse     pix_clk -> core_clk  : 2FF + edge detect in audio_sink
-//   * wave_rd channel pix_clk -> pix_clk   : same domain, direct wiring
-//   * overflow_cnt    clk_nco -> core_clk  : 2FF in sys_ctrl (quasi-static)
-//
-// Observation taps left unconnected at this milestone (consumed by the
-// T-M2-07 UART stats exporter; synthesis prunes them): wait_cnt_0..3,
-// addr_err, to_err, cmd_to_err, dbg_to_state, wlast_miss_cnt, win_tick,
-// win_id, mute_flag, err_cnt, fifo_full, sys_run, rx_byte_cnt,
-// dbg_line_wready.
-//
-// The DDR3 IP instance hierarchy is instrec_top.ddr3_wrapper.I_ips_ddr_top
-// (constraint paths in ddr3_100h.fdc depend on it, REQ-MEM-001).
-// -----------------------------------------------------------------------------
-
-`timescale 1ns / 1ps
-
-module instrec_top #(
-    // 0 = CPU-controlled launch; 1 = automatic Mel -> NPU launch. Weights load
-    // before sys_ctrl reaches RUN; CPU requests launch at a Mel boundary.
-    parameter NPU_ENABLE = 0,
-    // 0 = feat_dump is withheld from m3 (bisect state: the DDR3 boot self-test
-    //     fails at its second burst while the dump engine shares m3);
-    // 1 = feat_dump writes the Mel feature to DDR 0x0020_0000 (needed for the
-    //     complete-feature readback described in DIAG_READBACK_PLAN_20261110).
-    // Flip this to 1 once the self-test interaction is understood.
-    parameter FEAT_DUMP_ON_M3 = 0
-) (
-    // ---- board pins ----
-    input  wire        clk,          // 27 MHz crystal (D18)
-    input  wire        rst_n,        // KEY0, active low (C22)
-    input  wire        key1_n,       // KEY1, export trigger (C23)
-    output wire [7:0]  led,          // status LEDs (A20..B17)
-    input  wire        uart_rx,      // CP2102 RX (B24)
-    output wire        uart_tx,      // CP2102 TX (C24)
-    // ---- I2S audio pins ----
-    input  wire        i2s_bck,      // PCM1808 bit clock 3.072 MHz (U20)
-    input  wire        i2s_lrck,     // PCM1808 frame clock 48 kHz (T20)
