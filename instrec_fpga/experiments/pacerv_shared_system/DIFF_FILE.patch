+                         grp_total=16'd128;   // 8 * 16
+                         taps_per_grp=16'd1728; tap_bytes=8'd16;
+                         group_bytes=16'd27648; grp_beats=16'd864; end
+            4'd4: begin wb=28'd656000; bb=28'd688768; mb=28'd689280; sb=28'd689792;
