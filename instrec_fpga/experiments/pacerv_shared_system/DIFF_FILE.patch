+    // =====================================================================
+    // UART transmit FIFO (16 bytes)
+    // =====================================================================
+    reg [7:0]  txq [0:15];
+    reg [4:0]  tx_wr, tx_rd;
+
+    wire [4:0] tx_count  = tx_wr - tx_rd;
+    wire       tx_push   = d_req_valid && d_req_ready && d_req_write &&
+                           (d_req_address == 32'h8000_000C) && (tx_count != 5'd16);
+    wire       tx_ready  = (tx_count != 5'd16);
