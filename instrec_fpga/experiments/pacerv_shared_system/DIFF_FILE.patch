+        .pll_lock       (ddr_pll_lock),
+        .ddrphy_cpd_lock(ddrphy_cpd_lock),
+        .axi_awaddr     (axi_awaddr),
+        .axi_awuser_ap  (axi_awuser_ap),
+        .axi_awuser_id  (axi_awuser_id),
+        .axi_awlen      (axi_awlen),
+        .axi_awvalid    (axi_awvalid),
+        .axi_awready    (axi_awready),
+        .axi_wdata      (axi_wdata),
+        .axi_wstrb      (axi_wstrb),
+        .axi_wready     (axi_wready),
+        .axi_wusero_id  (axi_wusero_id),
+        .axi_wusero_last(axi_wusero_last),
+        .axi_araddr     (axi_araddr),
+        .axi_aruser_ap  (axi_aruser_ap),
+        .axi_aruser_id  (axi_aruser_id),
+        .axi_arlen      (axi_arlen),
+        .axi_arvalid    (axi_arvalid),
+        .axi_arready    (axi_arready),
+        .axi_rdata      (axi_rdata),
+        .axi_rid        (axi_rid),
+        .axi_rlast      (axi_rlast),
+        .axi_rvalid     (axi_rvalid),
+        .mem_cs_n       (mem_cs_n),
+        .mem_rst_n      (mem_rst_n),
+        .mem_ck         (mem_ck),
+        .mem_ck_n       (mem_ck_n),
+        .mem_cke        (mem_cke),
+        .mem_ras_n      (mem_ras_n),
+        .mem_cas_n      (mem_cas_n),
+        .mem_we_n       (mem_we_n),
+        .mem_odt        (mem_odt),
+        .mem_a          (mem_a),
+        .mem_ba         (mem_ba),
+        .mem_dqs        (mem_dqs),
+        .mem_dqs_n      (mem_dqs_n),
+        .mem_dq         (mem_dq),
+        .mem_dm         (mem_dm)
+    );
+
+    // ---- DDR3 write-read self test (master 3, self-test pattern area) ----
+    // master-3 write-beat pulse (C-SELFTEST@1 F2/S1/S2).  Without this tap
+    // PDS reports "Verilog-2036: Net st_wready_beat ... has no driver, tie
+    // it to 0"; self_test then never sees a beat handshake and the first
+    // write command aborts with st_fail at SELFTEST_BASE.
+    assign st_wready_beat = m3c_wready[0];
+
+    // ------------------------------------------------------------------
+    // UART dispatch: weight_loader keeps the 0xAA55 binary frame protocol;
+    // the diagnostic engine receives non-0xAA bytes only while the loader is
+    // idle (the loader ignores them anyway, this just avoids contention).
+    // ------------------------------------------------------------------
+    // A 0xAA byte is normally kept away from the diagnostic engine because the
+    // weight loader owns the 0xAA55 frame header.  Dropping it unconditionally
+    // used to corrupt any 'R' whose address or length contains 0xAA (the diag
+    // FSM lost one argument byte, every following byte shifted, and the
+    // channel ended up spamming NAKs with no way back).  Forward 0xAA while the
+    // diag engine is collecting 'R' arguments -- that is the only place it can
+    // legitimately appear.
+    wire dg_rx_sel = rx_byte_valid && (!wl_busy) &&
+                     ((rx_byte_data != 8'hAA) || dg_rx_in_arg);
+
+    diag_readback u_diag (
+        .clk            (core_clk),
+        .rst_n          (core_clk_rst_n),
+        .rx_valid       (dg_rx_sel),
+        .rx_data        (rx_byte_data),
+        .tx_valid       (dg_tx_valid),
+        .tx_data        (dg_tx_data),
+        .tx_ready       (dg_tx_ready),
+        .m3_cmd_valid   (dg_m3_cmd_valid),
+        .m3_cmd         (dg_m3_cmd),
+        .m3_rd_data     (m3c_rdata),
+        .m3_rd_valid    (m3c_rvalid[1]),
+        .m3_rd_ready    (dg_m3_rd_ready),
+        .m3_done        (m3c_done[1]),
+        .diag_lock      (dg_lock),
+        .rx_in_arg      (dg_rx_in_arg),
+        .win_id         (win_id),
+        .mel_done       (mel_done),
+        .npu_done       (npu_done_raw),
+        .logits_valid   (npu_logits_valid),
+        .logits_in      (npu_logits_out)
+    );
+
+    self_test u_self_test (
+        .clk          (core_clk),
+        .rst_n        (core_clk_rst_n),
+        .st_start     (st_start),
+        .cmd_valid    (st_cmd_valid),
+        .cmd          (st_m3_cmd),
+        .wdata        (st_m3_wdata),
+        .wready_beat  (st_wready_beat),
+        .rd_ready     (st_rd_ready),
+        .rd_data      (m3c_rdata),
+        .rd_valid     (m3c_rvalid[0]),
+        .done         (m3c_done[0]),
+        .st_done      (st_done),
+        .st_fail      (st_fail),
+        .st_fail_addr (st_fail_addr)
+    );
+
+    // ---- System controller (boot self-test chain + LED encoding) ----
+
+    wire weight_start_unused;
+
+    sys_ctrl #(.PLL_TIMEOUT_CYCLES(546875000), .DDR_TIMEOUT_CYCLES(10937500)) u_sys_ctrl (
+        .weight_ok    (weight_ok),
+        .weight_err   (weight_err),
+        .weight_start (weight_start_unused),
+        .clk             (core_clk),
+        .rst_n           (core_clk_rst_n),
+        .pll_locked      (pll_audio_locked),
+        .ddrphy_cpd_lock (ddrphy_cpd_lock),
+        .ddr_init_done   (ddr_init_done),
+        .hdmi_init_over  (hdmi_init_over),
+        .hdmi_init_fail  (hdmi_init_fail),
+        .sd_idle         (sd_idle),
+        .overflow_cnt    (overflow_cnt),
+        .st_start        (st_start),
+        .st_done         (st_done),
+        .st_fail         (st_fail),
+        .st_fail_addr    (st_fail_addr),
+        // DDR3 AXI diagnostic taps: consumed by sys_ctrl for the
+        // "DDR3 STS <hex8>" line (T21).  These nets were left dangling
+        // (no consumer) until now.
+        .ddr_dbg_to_state(ddr_dbg_to_state),
+        .ddr_to_err      (ddr_to_err),
+        .ddr_cmd_to_err  (ddr_cmd_to_err),
+        .audio_sd_idle   (sd_idle),
+        .audio_fifo_empty(fifo_empty),
+        .audio_fifo_full (fifo_full),
+        .audio_win_frames(win_fifo_cnt_lat),
+        .audio_win_id    (win_id[7:0]),
+        .audio_err_cnt   (audio_err_cnt),
+        .audio_freeze_cycles(audio_freeze_cycles),
+        .audio_page_cnt  (audio_page_cnt),
+        .audio_done_cnt  (audio_done_cnt),
+        .mel_timeout     (mel_timeout),
+        .mel_win_miss    (mel_win_miss),
+        .mel_busy        (mel_busy),
+        .dbg_line_id     (dbg_line_id),
+        .dbg_line_arg    (dbg_line_arg),
+        .dbg_line_fire   (dbg_line_fire),
+        .dbg_busy        (dbg_busy),
+        .sys_run         (sys_run),
+        .safe_err        (safe_err),
+        .stage_code      (stage_code),
+        .heartbeat       (heartbeat),
+        .overflow_warn   (overflow_warn),
+        .key1_n          (key1_n)
+    );
+
+    // ---- UART physical byte layer ----
+    wire [7:0] dbg_tx_data;
+    wire       dbg_tx_valid;
+    wire       dbg_tx_ready;
+
+    reg tx_accept_hold;
+    wire tx_accept_ready = tx_byte_ready & ~tx_accept_hold;
+    always @(posedge core_clk or negedge core_clk_rst_n) begin
+        if (!core_clk_rst_n) tx_accept_hold <= 1'b0;
+        else if (!tx_byte_ready) tx_accept_hold <= 1'b0;
+        else if (tx_accept_ready && (wl_tx_valid | dbg_tx_valid | dg_tx_valid | cpu_tx_valid))
+            tx_accept_hold <= 1'b1;
+    end
+    assign wl_tx_ready   = tx_accept_ready;
+    assign dbg_tx_ready  = tx_accept_ready & ~wl_tx_valid;
+
+    // ---- RV32 control core (lowest-priority UART source) ----
+    wire        cpu_tx_valid;
+    wire [7:0]  cpu_tx_data;
+    wire [7:0]  cpu_led;
+    wire        cpu_alive;
+    wire        cpu_trap;
+    wire [31:0] cpu_trap_cause;
+    wire        cpu_npu_start;
+    wire        cpu_tx_ready;
+
+    uart_tx #(.BAUD_DIV(949)) u_uart_tx (
+        .clk         (core_clk),
+        .rst_n       (core_clk_rst_n),
+        .byte_wdata  (wl_tx_valid ? wl_tx_data :
+                      (dbg_tx_valid ? dbg_tx_data :
+                       (dg_tx_valid ? dg_tx_data : cpu_tx_data))),
+        .byte_wvalid ((wl_tx_valid | dbg_tx_valid | dg_tx_valid |
+                       cpu_tx_valid) & ~tx_accept_hold),
+        .byte_wready (tx_byte_ready),
+        .uart_txd    (uart_tx)
+    );
+
+    // The CPU may only pop its FIFO when the multiplexer actually selects it,
+    // otherwise a byte would be consumed while wl/dbg data goes out instead.
+    assign cpu_tx_ready = tx_accept_ready & ~wl_tx_valid & ~dbg_tx_valid & ~dg_tx_valid;
+    assign dg_tx_ready  = tx_accept_ready & ~wl_tx_valid & ~dbg_tx_valid;
+
+    uart_rx #(.BAUD_DIV(949)) u_uart_rx (
+        .clk         (core_clk),
+        .rst_n       (core_clk_rst_n),
+        .uart_rxd    (uart_rx),
+        .byte_rdata  (rx_byte_data),
+        .byte_rvalid (rx_byte_valid)
+    );
+
+    // ---- Weight loader (T-M2-01): UART frames -> DDR3 master 1 ----
+
+    weight_loader #(.BASE_ADDR(28'h100000)) u_weight_loader (
+        .clk         (core_clk),
+        .rst_n       (core_clk_rst_n),
+        .rx_valid    (rx_byte_valid && !npu_busy_u && !npu_start && !native_fault),
+        .rx_data     (rx_byte_data),
+        .tx_valid    (wl_tx_valid),
+        .tx_data     (wl_tx_data),
+        .tx_ready    (wl_tx_ready),
+        .cmd_valid   (wl_cmd_valid),
+        .cmd         (wl_cmd),
+        .wdata       (wl_wdata),
+        .wready_beat (loader_m1_wready),
+        .done        (loader_m1_done),
+        .rd_ready    (wl_rd_ready),
+        .rd_data     (rd_data_1),
+        .rd_valid    (loader_m1_rvalid),
+        .busy        (wl_busy),
+        .weight_ok   (weight_ok),
+        .weight_err  (weight_err),
+        .err_addr    (wl_err_unused),
+        .frame_cnt   (wl_cnt_unused),
+        .digest      (wl_digest_unused)
+    );
+
+    // ---- NPU top (T-M2-06): instantiated but gated off until the mel
+    // feat read port and m1 arbitration are finalized. Keeping the instance
+    // here fixes the top-level topology and lets PDS elaborate the chain.
+    wire        npu_busy_u, npu_done_u, npu_timeout_u;
+    wire [31:0] npu_cycles_u;
+    wire        npu_probs_valid_u;
+    wire [7:0]  npu_probs_pct_u;
+    wire [3:0]  npu_probs_idx_u;
+    wire        npu_feat_rd_en_u;
+    reg cpu_npu_pending;
+    wire npu_launch_ready = sys_run && st_done && !st_fail && !safe_err &&
+                            ddr_init_done && weight_ok && !weight_err &&
+                            !wl_busy && !npu_busy_u && native_owner_idle && !native_fault;
+    wire npu_start = mel_npu_start && npu_launch_ready &&
+                     (NPU_ENABLE || cpu_npu_pending || cpu_npu_start);
+    always @(posedge core_clk or negedge core_clk_rst_n) begin
+        if (!core_clk_rst_n) cpu_npu_pending <= 1'b0;
+        else if (npu_start) cpu_npu_pending <= 1'b0;
+        else if (cpu_npu_start) cpu_npu_pending <= 1'b1;
+    end
+
+    npu_top #(.FEATURE_FRAME_MAJOR(1)) u_npu (
+        .clk          (core_clk),
+        .rst_n        (core_clk_rst_n),
+        .start        (npu_start),
+        .busy         (npu_busy_u),
+        .done         (npu_done_raw),
+        .npu_cycles   (npu_cycles_u),
+        .timeout_flag (npu_timeout_raw),
+        .feat_rd_addr (npu_feat_rd_addr),
+        .feat_rd_data (mel_feat_rd_data),
+        .feat_rd_en   (npu_feat_rd_en_u),
+        .rd_cmd_valid (npu_rd_cmd_valid_u),
+        .rd_cmd       (npu_rd_cmd_u),
+        .rd_ready     (npu_rd_ready_u),
+        .rd_data      (npu_weight_data),
+        .rd_valid     (npu_weight_valid),
+        .rd_done      (npu_weight_done),
+        .act_cmd_valid(act_cmd_valid), .act_cmd_write(act_cmd_write), .act_cmd_addr(act_cmd_addr),
+        .act_cmd_ready(act_cmd_ready), .act_wr_valid(act_wr_valid), .act_wr_data(act_wr_data),
+        .act_wr_ready(act_wr_ready), .act_rd_valid(act_rd_valid), .act_rd_data(act_rd_data),
+        .probs_valid  (npu_probs_valid_raw),
+        .probs_pct    (npu_probs_pct_u),
+        .probs_idx    (npu_probs_idx_u),
+        .top1         (npu_top1_u)
+        ,.logits_out  (npu_logits_out)
+        ,.logits_valid(npu_logits_valid)
+    );
+
+    // ---- Debug line formatter (M0: status lines only, no text writer) ----
+    uart_debug u_uart_debug (
+        .clk            (core_clk),
+        .rst_n          (core_clk_rst_n),
+        .tx_byte_data   (dbg_tx_data),
+        .tx_byte_valid  (dbg_tx_valid),
+        .tx_byte_ready  (dbg_tx_ready),
+        .rx_byte_data   (rx_byte_data),
+        .rx_byte_valid  (rx_byte_valid),
+        .dbg_line_wdata (8'd0),
+        .dbg_line_wvalid(1'b0),
+        .dbg_line_wready(dbg_line_wready),
+        .dbg_line_id    (dbg_line_id),
+        .dbg_line_arg   (dbg_line_arg),
+        .dbg_line_fire  (dbg_line_fire),
+        .dbg_busy       (dbg_busy),
+        .rx_byte_cnt    (uart_rx_byte_cnt)
+    );
+
+    rv32_cpu_subsys #(
+        .ENABLE_M         (1),
+        .ENABLE_C         (1),
+        .ENABLE_PREDICTOR (1),
+        .RESET_VECTOR     (32'h0000_0000),
+        .PROG_HEX         ("src/cpu/prog_pacerv.hex")
+    ) u_cpu (
+        .clk             (core_clk),
+        .rst_n           (core_clk_rst_n),
+        .npu_busy        (npu_busy_u),
+        .npu_done        (npu_done_u),
+        .npu_timeout     (npu_timeout_u),
+        .npu_probs_valid (npu_probs_valid_u),
+        .npu_probs_pct   (npu_probs_pct_u),
+        .npu_probs_idx   (npu_probs_idx_u),
+        .npu_top1        (npu_top1_u),
+        .npu_cycles      (npu_cycles_u),
+        .ddr_ok          (ddr_init_done & st_done & ~st_fail & ~safe_err &
+                          ~cpu_dd_fault & ~m3_share_fault),
+        .ddr_err         (safe_err | cpu_dd_fault | m3_share_fault),
+        .ddr_sts         ({6'h00, cpu_dd_fault, m3_share_fault, 8'h00, ddr_cmd_to_err, ddr_to_err,
+                           ddr_dbg_to_state, st_fail, st_done, 6'h00}),
+        .uart_valid      (cpu_tx_valid),
+        .uart_data       (cpu_tx_data),
+        .uart_ready      (cpu_tx_ready),
+        .cpu_led         (cpu_led),
+        .cpu_alive       (cpu_alive),
+        .cpu_trap        (cpu_trap),
+        .cpu_trap_cause  (cpu_trap_cause),
+        .npu_soft_start  (cpu_npu_start),
+        .dd_req_valid    (cpu_dd_req_valid), .dd_req_ready(cpu_dd_req_ready),
+        .dd_req_address  (cpu_dd_req_address), .dd_req_write(cpu_dd_req_write),
+        .dd_req_data     (cpu_dd_req_data), .dd_req_strobe(cpu_dd_req_strobe),
+        .dd_rsp_valid    (cpu_dd_rsp_valid), .dd_rsp_ready(cpu_dd_rsp_ready),
+        .dd_rsp_data     (cpu_dd_rsp_data), .dd_rsp_error(cpu_dd_rsp_error)
+    );
+
+    // ==================================================================
+    // LED assembly (design doc section 2.2.9 / sys_ctrl contract):
+    //   led[7:6] self-test stage code
+    //   led[5]   CDC FIFO overflow warning (sticky)
+    //   led[4]   SAFE_ERR latched state
+    //   led[3:1] NPU busy / CPU trap / CPU alive
+    //   led[0]   1 Hz heartbeat (active after RUN)
+    // ==================================================================
+    assign led = {stage_code, overflow_warn, (safe_err | cpu_dd_fault | m3_share_fault),
+                  npu_busy_u, cpu_trap, cpu_alive, heartbeat};
+
+endmodule
