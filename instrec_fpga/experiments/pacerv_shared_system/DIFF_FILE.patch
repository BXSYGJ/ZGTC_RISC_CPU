+    (* syn_ramstyle = "block_ram" *) reg [255:0] param_bm [0:63];
+    (* syn_ramstyle = "block_ram" *) reg [255:0] param_shift [0:15];
+    reg [255:0] param_bm_q;
+    reg [255:0] param_shift_q;
+    reg [4:0] param_lane_q;
+    reg param_shift_sel_q;
+    reg param_q_valid;
