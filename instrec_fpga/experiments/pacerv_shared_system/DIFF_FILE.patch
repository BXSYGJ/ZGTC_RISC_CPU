+    reg [31:0] i_even_q, i_odd_q;
+    reg        i_primary_odd_q, i_pair_odd_q, i_pair_valid_q;
+    reg        i_err_q;
+    wire i_address_ok = (i_req_address[31:IAW+2] == 0) && (i_req_address[1:0] == 0);
