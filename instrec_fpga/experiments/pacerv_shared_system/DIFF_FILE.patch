+            i_primary_odd_q <= 1'b0;
+            i_pair_odd_q <= 1'b0;
+            i_pair_valid_q <= 1'b0;
+            i_err_q <= 1'b0;
+        end else if (i_req_valid && i_req_ready) begin
+            i_pend <= 1'b1;
+            i_primary_odd_q <= i_req_address[2];
+            i_pair_odd_q <= i_req_pair_address[2];
+            i_pair_valid_q <= i_address_ok && i_pair_address_ok;
