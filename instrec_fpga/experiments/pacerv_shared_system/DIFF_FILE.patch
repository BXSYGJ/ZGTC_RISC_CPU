diff --git a/instrec_fpga/src/ddr3/ddr3_m3_share.v b/instrec_fpga/src/ddr3/ddr3_m3_share.v
new file mode 100644
index 0000000..909f26f
--- /dev/null
+++ b/instrec_fpga/src/ddr3/ddr3_m3_share.v
@@ -0,0 +1,91 @@
+`timescale 1ns/1ps
+// ddr3_m3_share: clients are 0 boot, 1 diagnostic, 2 feature export, 3 CPU.
+// Boot owns the port until boot_done. Afterwards transactions are round-robin.
+// Each command valid must return low before that client can issue again.
+module ddr3_m3_share (
+    input wire clk, rst_n, boot_done,
+    input wire [3:0] c_valid,
+    input wire [147:0] c_cmd,
+    input wire [1023:0] c_wdata,
+    input wire [127:0] c_wstrb,
+    input wire [3:0] c_rd_ready,
+    output wire [3:0] c_wready, c_rvalid, c_done, c_abort,
+    output wire [255:0] c_rdata,
+    output wire m_valid,
+    output wire [36:0] m_cmd,
+    output wire [255:0] m_wdata,
+    output wire [31:0] m_wstrb,
+    output wire m_rd_ready,
+    input wire m_wready, m_rvalid,
+    input wire [255:0] m_rdata,
+    input wire m_done, m_abort,
+    output reg fault,
+    output reg [1:0] owner,
+    output reg active
+);
+    reg [36:0] cmd_q;
+    reg done_seen;
+    reg [4:0] reads_left;
+    reg [3:0] armed;
+    reg [1:0] next_owner;
+    reg choose_valid;
+    reg [1:0] chosen;
+    integer offset;
+    reg [1:0] candidate;
+    wire delivered = m_rvalid && m_rd_ready;
+    wire finished = active && done_seen && reads_left==0;
+    wire [3:0] owner_bit = 4'b0001 << owner;
+    always @* begin
+        choose_valid=0; chosen=0; candidate=0;
+        if(!boot_done) begin
+            choose_valid=c_valid[0] && armed[0]; chosen=0;
+        end else begin
+            for(offset=0;offset<4;offset=offset+1) begin
+                candidate=next_owner+offset;
+                if(!choose_valid && c_valid[candidate] && armed[candidate]) begin
+                    choose_valid=1; chosen=candidate;
+                end
+            end
+        end
+    end
+    assign m_valid = active && !done_seen && !fault && !m_abort;
+    assign m_cmd = cmd_q;
+    assign m_wdata = c_wdata[owner*256 +: 256];
+    assign m_wstrb = c_wstrb[owner*32 +: 32];
+    assign m_rd_ready = active && (fault || m_abort || c_rd_ready[owner]);
+    assign c_wready = active && !fault && !m_abort && m_wready ? owner_bit : 4'd0;
+    assign c_rvalid = active && !fault && !m_abort && m_rvalid ? owner_bit : 4'd0;
+    assign c_rdata = m_rdata;
+    // Preserve the legacy raw command-completion edge (in particular, final
+    // write-ready and done coincide). Ownership and read routing remain locked
+    // independently until finished, after every queued read beat is consumed.
+    // CPU bridge separately joins raw done with its captured data/error state.
+    assign c_done = active && !fault && (m_done || m_abort) ? owner_bit : 4'd0;
+    assign c_abort = fault ? 4'hf : (active && m_abort ? owner_bit : 4'd0);
+    always @(posedge clk or negedge rst_n) begin
+        if(!rst_n) begin
+            active<=0; owner<=0; cmd_q<=0; done_seen<=0; reads_left<=0;
+            armed<=4'hf; next_owner<=1; fault<=0;
+        end else begin
+            // A held valid belongs to the just-completed command. It cannot
+            // be regranted even if a client consumes done a cycle later.
+            armed<=armed | ~c_valid;
+            if(!active && !fault) begin
+                if(choose_valid) begin
+                    active<=1; owner<=chosen; cmd_q<=c_cmd[chosen*37 +: 37];
+                    armed[chosen]<=0; done_seen<=0;
+                    reads_left<=c_cmd[chosen*37+36] ? 0 :
+                        {1'b0,c_cmd[chosen*37 +: 4]}+1;
+                    if(c_cmd[chosen*37 +: 8]>15) fault<=1;
+                end
+            end else if(active) begin
+                if(m_done) done_seen<=1;
+                if(delivered && reads_left!=0) reads_left<=reads_left-1;
+                if(m_abort) begin fault<=1; active<=0; end
+                else if(finished && !fault) begin
+                    active<=0; next_owner<=owner+1;
+                end
+            end
+        end
+    end
+endmodule
diff --git a/instrec_fpga/src/ddr3/pace_cpu_ddr_bridge.v b/instrec_fpga/src/ddr3/pace_cpu_ddr_bridge.v
new file mode 100644
index 0000000..bcc59fd
--- /dev/null
+++ b/instrec_fpga/src/ddr3/pace_cpu_ddr_bridge.v
@@ -0,0 +1,118 @@
+`timescale 1ns/1ps
+// pace_cpu_ddr_bridge: single-outstanding CPU word bus to the shared DDR bus.
+// Byte/halfword stores arrive as word-aligned data with four byte strobes.
+// CPU APP: 40000000..400fffff -> DDR 00600000..006fffff (read/write).
+// CPU OBS: 41000000..415fffff -> DDR 00000000..005fffff (legal reads only).
+module pace_cpu_ddr_bridge #(
+    parameter integer REQ_TIMEOUT = 1048576
+) (
+    input wire clk, rst_n, ddr_ok,
+    input wire req_valid,
+    output wire req_ready,
+    input wire [31:0] req_address,
+    input wire req_write,
+    input wire [31:0] req_data,
+    input wire [3:0] req_strobe,
+    output wire rsp_valid,
+    input wire rsp_ready,
+    output wire [31:0] rsp_data,
+    output wire rsp_error,
+    output wire m_cmd_valid,
+    output wire [36:0] m_cmd,
+    output wire [255:0] m_wdata,
+    output wire [31:0] m_wstrb,
+    output wire m_rd_ready,
+    input wire m_wready, m_rvalid,
+    input wire [255:0] m_rdata,
+    input wire m_done, m_abort,
+    output reg fault
+);
+    localparam [1:0] IDLE=0, CHECK_REQUEST=1, WAIT_DDR=2, RESPONSE=3;
+    reg [1:0] state;
+    reg [27:0] address_q;
+    reg [31:0] cpu_address_q;
+    reg write_q;
+    reg [31:0] data_q;
+    reg [3:0] strobe_q;
+    reg [2:0] word_q;
+    reg done_seen, read_seen, write_seen;
+    reg [31:0] read_q, wait_count;
+    reg response_error;
+    wire app_region = cpu_address_q >= 32'h40000000 && cpu_address_q <= 32'h400ffffc;
+    wire obs_region = cpu_address_q >= 32'h41000000 && cpu_address_q <= 32'h415ffffc;
+    wire [27:0] obs_address = {4'b0000,cpu_address_q[23:0]};
+    wire obs_legal = (obs_address <= 28'h00c5ffc) ||
+        (obs_address >= 28'h0100000 && obs_address <= 28'h01b7ffc) ||
+        (obs_address >= 28'h0200000 && obs_address <= 28'h020fffc) ||
+        (obs_address >= 28'h0300000 && obs_address <= 28'h030fffc) ||
+        (obs_address >= 28'h0400000 && obs_address <= 28'h043fffc) ||
+        (obs_address >= 28'h0440000 && obs_address <= 28'h045fffc);
+    wire legal_request = cpu_address_q[1:0]==2'b00 &&
+        (app_region || (obs_region && !write_q && obs_legal));
+    wire [27:0] translated = app_region ? {8'h06,cpu_address_q[19:0]} : obs_address;
+    wire complete = done_seen && (write_q ? write_seen : read_seen);
+    wire local_timeout = REQ_TIMEOUT != 0 && wait_count >= REQ_TIMEOUT-1;
+    assign req_ready = state==IDLE && ddr_ok;
+    assign rsp_valid = state==RESPONSE;
+    // Read payload is written only by a DDR beat. The valid bit supplies
+    // zero for writes/rejected requests, keeping CPU admission off its CE.
+    assign rsp_data = read_seen ? read_q : 32'd0;
+    assign rsp_error = response_error;
+    assign m_cmd_valid = state==WAIT_DDR && !done_seen && !fault;
+    assign m_cmd = {write_q,address_q,8'd0};
+    assign m_wdata = {{224{1'b0}},data_q} << {word_q,5'b0};
+    assign m_wstrb = {28'd0,strobe_q} << {word_q,2'b0};
+    // A local timeout answers the CPU and poisons future CPU operations.
+    // The M3 owner retains any already captured command and drains its tail;
+    // data_q/strobe_q are never overwritten while fault is latched.
+    assign m_rd_ready = (state==WAIT_DDR && !read_seen) || fault;
+    always @(posedge clk or negedge rst_n) begin
+        if(!rst_n) begin
+            state<=IDLE; address_q<=0; cpu_address_q<=0; write_q<=0; data_q<=0; strobe_q<=0;
+            word_q<=0; done_seen<=0; read_seen<=0; write_seen<=0;
+            read_q<=0; wait_count<=0; response_error<=0; fault<=0;
+        end else begin
+            case(state)
+                IDLE: begin
+                    response_error<=0; read_seen<=0;
+                    // Sample payload before checking ranges. CPU address
+                    // generation therefore drives data pins, not wide enables.
+                    if(!fault) begin
+                        cpu_address_q<=req_address; write_q<=req_write;
+                        data_q<=req_data; strobe_q<=req_strobe;
+                    end
+                    if(req_valid && req_ready) begin
+                        state<=CHECK_REQUEST;
+                        if(m_abort) fault<=1;
+                    end
+                end
+                CHECK_REQUEST: begin
+                    if(!legal_request || fault || m_abort) begin
+                        response_error<=1; state<=RESPONSE;
+                        if(m_abort) fault<=1;
+                    end else begin
+                        address_q<={translated[27:5],5'd0};
+                        word_q<=cpu_address_q[4:2];
+                        done_seen<=0; write_seen<=0;
+                        wait_count<=0; state<=WAIT_DDR;
+                    end
+                end
+                WAIT_DDR: begin
+                    wait_count<=wait_count+1;
+                    if(m_done) done_seen<=1;
+                    if(m_wready) write_seen<=1;
+                    if(m_rvalid && m_rd_ready) begin
+                        read_q<=m_rdata >> {word_q,5'b0}; read_seen<=1;
+                    end
+                    // Error is inspected after the registered done edge too:
+                    // the controller's timeout flags become visible after done.
+                    if(m_abort || local_timeout) begin
+                        response_error<=1; fault<=1; state<=RESPONSE;
+                    end else if(complete) state<=RESPONSE;
+                end
+                RESPONSE: if(rsp_ready) state<=IDLE;
+                default: state<=IDLE;
+            endcase
+        end
+    end
+endmodule
