+    assign i_rsp_pair_valid = i_pair_valid_q;
+    assign i_rsp_is_c = {i_rsp_data[17:16] != 2'b11, i_rsp_data[1:0] != 2'b11};
+    assign i_rsp_pair_is_c = {i_rsp_pair_data[17:16] != 2'b11, i_rsp_pair_data[1:0] != 2'b11};
