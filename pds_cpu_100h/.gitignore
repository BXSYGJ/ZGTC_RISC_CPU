build/
*.sbit
# 里程碑交付位流按 releases 归档入库（其余 sbit 仍是可重建产物）
!releases/**/*.sbit
*.smsk
*.bgr
*.db
log/
scripts/log/
scripts/*.log
scripts/*.local.tcl
# extracted vendor demo (reference material, not part of the build)
ref/
